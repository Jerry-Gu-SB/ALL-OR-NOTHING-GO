;1200 Hit Stagger (Slide)
[Statedef 6441]
type = S
movetype = H
physics = N

[State NotHitB, 1]
type = NotHitBy
triggerall = enemynear,name = "Bullet_BB"
trigger1 = enemynear,stateno = 1200
value = SCA, AA, AP, AT

[State HitB, 1]
type = HitBy
triggerall = enemynear,name = "Bullet_BB"
trigger1 = enemynear,stateno = 1205
value = SCA, AA, AP, AT
persistent = 1

[State VarA, 1];For Stagger Recovery
type = VarAdd
triggerall = sysvar(4) > 0
trigger1 = name != "Ares_BB"
trigger2 = name != "Itsumi_BB"
trigger3 = name != "Delta-4"
trigger4 = name != "Epsilon-5"
trigger5 = name != "Platinum_BB"
trigger6 = name != "Bullet_BB"
sysvar(4) = -1

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = gethitvar(xvel) * facing

[State VelM, 1];Stop sliding back
type = VelMul
trigger1 = 1
x = .88

[State SelfS, 1]
type = SelfState
triggerall = alive
triggerall = anim = 5400
triggerall = sysvar(4) = 0
triggerall = command = "recovery"
trigger1 = name = "Ares_BB"
trigger2 = name = "Itsumi_BB"
trigger3 = name = "Delta-4"
trigger4 = name = "Epsilon-5"
trigger5 = name = "Platinum_BB"
trigger6 = name = "Bullet_BB"
value = 5405
ctrl = 0

[State SelfS, 1]
type = SelfState
triggerall = anim = 5400
triggerall = sysvar(4) = 0 || hitover
trigger1 = name = "Ares_BB"
trigger2 = name = "Itsumi_BB"
trigger3 = name = "Delta-4"
trigger4 = name = "Epsilon-5"
trigger5 = name = "Platinum_BB"
trigger6 = name = "Bullet_BB"
value = 5402
ctrl = 0

[State ChangeAnim, 1]
type = ChangeAnim
triggerall = anim != 5400
trigger1 = animtime = 0
value = 5017

[State SelfS, 1]
type = SelfState
triggerall = anim != 5400
trigger1 = hitover
value = 5100
ctrl = 0

;-------------------------------------------------------------------------------
;1210/1470 (Level 1)/3000 (1st, 2nd)/3030 (1st) Hit Shake
[Statedef 6442]
type = A
movetype = H
physics = N
velset = 0,0

[State PosS, 1]
type = PosSet
trigger1 = pos Y > 0
y = 0

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) != [3,5]
value = ifelse((gethitvar(airtype) = 1),5000,5010) + gethitvar(animtype)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) = [3,5]
value = ifelse((gethitvar(animtype) = [4,5]), (ifelse(selfanimexist(5047 + gethitvar(animtype)), 5047 + gethitvar(animtype), 5030)), 5030)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = (gethitvar(animtype) = [4,5]) && (selfanimexist(5047 + gethitvar(animtype)))
value = 5047 + gethitvar(animtype)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time > 0
value = anim

[State ChangeS, 1]
type = ChangeState
trigger1 = HitShakeOver
value = 6443

;-------------------------------------------------------------------------------
;1210/1470 (Level 1)/3000 (1st, 2nd)/3030 (1st) Hit Fall
[Statedef 6443]
type = A
movetype = H
physics = N

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = gethitvar(xvel) * facing
y = gethitvar(yvel)

[State VelA, 1]
type = VelAdd
trigger1 = 1
y = gethitvar(yaccel)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = selfanimexist(5035)
trigger1 = anim != 5050
trigger1 = anim != [5051,5059]
trigger1 = anim != 5090
value = 5035

[State ChangeA, 1]
type = ChangeAnim
trigger1 = animtime = 0
trigger1 = anim = 5035
trigger2 = time = 0
trigger2 = anim != 5035
trigger2 = (anim != [5051, 5059]) && (anim != [5061, 5069])
trigger2 = anim != 5090
value = 5050

[State ChangeA, 1]
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = vel Y >= ifelse(anim = 5050, -1, -10)
trigger1 = selfanimexist(anim+10)
value = anim+10
persistent = 0

[State ChangeA, 1]
type = ChangeAnim
triggerall = anim != 5415
trigger1 = anim = 5090
trigger1 = vel Y >= 0
value = 5060
persistent = 0

[State SelfS, 1]
type = SelfState
trigger1 = vel Y > 0
trigger1 = pos Y >= 0
value = 5100

