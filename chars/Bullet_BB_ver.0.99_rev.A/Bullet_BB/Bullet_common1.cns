triggerall = var(21) = 1
triggerall = fvar(29) > 0
trigger1 = numhelper(7150) = 0
name = "Barrier"
ID = 7150
Stateno = 7150
pos = 0,0
postype = p1

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2 + ((statetype = S && var(6))*3)

[State 120, 2]
type = StateTypeSet
trigger1 = Time >= 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time >= 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time >= 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
triggerall = statetype = S
trigger1 = !AILevel
trigger1 = command = "holddown"
statetype = C
Physics = C

[State 120, Lo to Hi]
type = StateTypeSet
triggerall = statetype = C
trigger1 = !AILevel
trigger1 = command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State CtrlS, 1]
type = CtrlSet
trigger1 = var(21) = 1
value = 0

[State CtrlS, 1]
type = CtrlSet
trigger1 = !AILevel
trigger1 = var(21) = 0
value = 1

[State 120, Stop Guarding]
type = ChangeState
trigger1 = !AILevel
trigger1 = command != "holdback"
trigger2 = AILevel
trigger2 = !inguarddist || enemynear,animtime >= -6
value = 140

