trigger1 = Time = 1
value = 200, Random % 3


[State 200, VelSet]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno = 20
x = 0


[State -2, Starter Level]
type 		= MapSet
trigger1 		= movehit && !map(ComboStateCheck)
map 			= "StarterLevel"
value 		= 1
ignorehitpause 	= 1

[State -2, P1 Value Set]
type 		= MapSet
trigger1 		= movehit && !map(ComboStateCheck)
map 		= "P1"
value 		= 0.85	;100% Starting DMG
ignorehitpause 	= 1
[State -2, P2 Value Set]
type 		= MapSet
trigger1 		= movehit && map(ComboStateCheck)
trigger1		= prevstateno != 200 || prevstateno != 400
map 		= "P2"
value 		= 0.75	;85% DMG For next hit
ignorehitpause 	= 1
persistent = 0
[State -2, P2 Accumulation - Scale]
type 		= MapSet
trigger1 		= movehit
trigger1		= prevstateno != 200 || prevstateno != 400
map 		= "Accumulation"
value 		= Map(Accumulation) * map(P2)
ignorehitpause 	= 1
persistent 		= 0

[State 0, JORMUNGANDR DEFAULT HITDEF]
type 				= HitDef
trigger1 				= !movecontact && !movereversed
;===============================
damage 				= 300 * MAP(P4),0
pausetime 			= 10,10 + 2 * enemy, movetype = A
getpower 				= 25 * MAP(GEAR.MUL),0
;===============================
attr 				= S,NA
hitflag 				= MAF
guardflag 			= M
animtype 				= Light
air.animtype 			= Light
ground.TYPE 			= High
air.TYPE 				= High
priority = 1, Hit 
;===============================
sparkno 				= 1
sparkxy 				= -p2dist x * 0.25, -50
hitsound 				= 5,0
guardsound 			= 6,0
;===============================
ground.hittime 		= 16
ground.slidetime		= 10
air.hittime 			= 14
down.hittime 			= 10
ground.velocity 		= -5
air.velocity 			= -2,-2
;===============================
guard.ctrltime 		= 11
guard.slidetime		= 8
guard.velocity 		= -6
airguard.velocity 		= -1,-1
;===============================
ground.cornerpush.veloff	= -4
air.cornerpush.veloff 	= -4
down.cornerpush.veloff 	= -8
guard.cornerpush.veloff 	= -8
;===============================
fall 				= 0
air.fall 				= 1
;===============================
envshake.time 			= 8
envshake.freq 			= 8
envshake.ampl 			= 1
envshake.phase 		= 0.5

[State 0, Jump Cancel]
type 		= MapSet
trigger1 		= movehit
map 		= "JC"
value 		= 1
ignorehitpause 	= 1

[State 200, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

