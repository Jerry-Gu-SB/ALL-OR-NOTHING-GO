;Air Dash End (Forward)
[Statedef 111]
type = A
physics = A
anim = 111

[State VarS, 1]
type = VarSet
trigger1 = time = 0
var(16) = 1
ignorehitpause = 1

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = 10

[State ChangeA, 1]
type = ChangeAnim
triggerall = anim != 7
trigger1 = p2dist X < Const720p(-80)
value = 7

[State Turn, 1]
type = Turn
trigger1 = anim = 7 && animelemtime(1) = 0
persistent = 0

[State ChangeA, 1];Change from turning animation
type = ChangeAnim
trigger1 = anim = 7 && animtime = 0
value = ifelse((vel x) = 0, 44, ifelse((vel x) > 0, 45, 46))

[State VarR, 1]
type = VarRandom
trigger1 = anim = 7
trigger1 = animelem = 1
v = 2
range = 0,1

[State PlayS, 1]
type = PlaySnd
triggerall = roundstate = 2
trigger1 = anim = 7
trigger1 = animelem = 1
value = 5, var(2)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State ChangeS, 1]
type = ChangeState
trigger1 = time >= 0
trigger1 = Pos Y > -1
value = 52

