trigger1 = var(36) = 1
value = 189

[State VarR, 1]
type = VarRandom
trigger1 = time = 0
v = 1
range = 0,1

[State 180, 2];Round Win
type = ChangeState
triggerall = time = 0
triggerall = var(36) = 0
trigger1 = matchover = 0
value = 181

[State 180, 2];Match Win 1
type = ChangeState
triggerall = time = 0
triggerall = var(36) = 0
triggerall = var(1) = 0
trigger1 = matchover = 1
value = 182

[State 180, 2];Match Win 2
type = ChangeState
triggerall = time = 0
triggerall = var(36) = 0
triggerall = var(1) = 1
trigger1 = matchover = 1
value = 183

