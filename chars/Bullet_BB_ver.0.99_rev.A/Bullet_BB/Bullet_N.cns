;-------------------------------------------------------------------------------
;5A
[Statedef 200]
type = S
movetype = A
physics = N
anim = 200
sprpriority = 2
ctrl = 0

[State Turn, 1]
type = Turn
trigger1 = !time && p2dist X < 0 && (prevstateno = 52 || (prevstateno = [200,1999]))

[State AttackD, 1]
type = AttackDist
trigger1 = animelemtime(6) < 0
value = 325
ignorehitpause = 1

[State VelM, 1]
type = VelMul
trigger1 = 1
x = 0.88

[State VelS, 1]
type = VelSet
triggerall = time = 0
trigger1 = prevstateno = [20,22]
x = 0

[State VarR, 1]
type = VarRandom
trigger1 = animelem = 3
v = 1
range = 0,7

[State PlayS, 1]
type = PlaySnd
triggerall = var(1) = [0,3]
trigger1 = animelem = 3
value = 200, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State PlayS, 1]
type = PlaySnd
trigger1 = animelem = 3
value = 301, 0
volumescale = helper(9999),var(15)

[State HitD, 1]
type = HitDef
trigger1 = animelem = 4
damage = ceil(30*fvar(1)*fvar(2)*fvar(5))
attr = S,NA
hitflag = MAFD
guardflag = MA
Animtype = Medium
air.Animtype = Medium
ground.type = High
air.type = High
priority = 3,Hit
sparkno = S6000+random%4
guard.sparkno = S6150+random%4
sparkxy = 0,-272
hitsound   = s302,1+((enemynear,movetype = A)*9)
guardsound = s303,0
pauseTime = 9,9
guard.pauseTime = 9,9
ground.slideTime = 12
guard.slideTime = 11
ground.hitTime = ceil(12+((enemynear,statetype = C)*2)+((fvar(4)*4)+(fvar(6)*3)))
guard.hitTime = ceil(11+((enemynear,statetype = A)*2))
air.hitTime = ceil(14+((fvar(4)*12)+(fvar(6)*3)))
ground.velocity = -12,0
air.velocity = -3,-12
airguard.velocity = -6,-6
air.fall = 1
fall = 0
fall.recoverTime = ceil(26+((fvar(4)*12)+(fvar(6)*3)))
yaccel = 1.4
fall.envshake.time = 20
fall.envshake.freq = 90
fall.envshake.ampl = 4
ground.cornerpush.veloff = -12 -fvar(3)
air.cornerpush.veloff = -12 -fvar(3)
palfx.time = (enemynear,movetype = A)*9
palfx.add = 100,-50,-50
getpower = ceil(40*fvar(1)*fvar(2)),ceil(20*fvar(1)*fvar(2))
p2facing = 1
down.bounce = 1

[State VarS, 1];Damage Counter/Proration 1 (First Hit of Combo)
type = VarSet
trigger1 = fvar(1) = 1
trigger1 = movehit = 1
ignorehitpause = 1
persistent = 1
fv = 1
value = .99

[State VarS, 1];Damage Counter/Proration 2 (Every Hit of Combo After First)
type = VarSet
trigger1 = fvar(1) != 1
trigger1 = movehit = 1
ignorehitpause = 1
persistent = 1
fv = 2
value = (.77 ** enemynear,gethitvar(hitcount))

[State Helper, 1];System "Counter"
type = Helper
trigger1 = fvar(4) = 1
trigger1 = movehit = 1
name = "Counter_Hit"
ID = 7230
Stateno = 7230
pos = 0,0
postype = back
ignorehitpause = 1
persistent = 0
ownpal = 1
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)

[State VarS, 1];Rapid Cancel Reset
type = VarSet
trigger1 = time = 0
ignorehitpause = 1
var(20) = 0

[State VarS, 1];Rapid Cancel
type = VarSet
trigger1 = movecontact = 1
ignorehitpause = 1
var(20) = 1

[State ChangeS, 1]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

