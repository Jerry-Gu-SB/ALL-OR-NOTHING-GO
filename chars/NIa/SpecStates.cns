;Air Jump Limiter ON
[Statedef 91]
type    = S
movetype= I
physics = N
juggle  = 1
velset = 0,0
ctrl = 0
anim = 9999
sprpriority = 3

[State 0,  ADD ONE]
type = ParentVarAdd
trigger1 = Time = 0
v = 5
value = 1

[State 200, End]
type = ChangeState
trigger1 = root,pos y >= 0
value = 92
;-------------------------------------------------------------------------------
