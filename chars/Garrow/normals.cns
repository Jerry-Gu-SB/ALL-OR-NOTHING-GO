damage    = 800
animtype  = Medium
hitflag = MAF
guardflag = L
priority = 2, Hit
getpower = 20,0
givepower = 20,0 
pausetime = 12,12
guard.pausetime = 12,12
sparkno = 1
sparkxy = -10,-55
hitsound   = 5,2
guardsound = 6,0
