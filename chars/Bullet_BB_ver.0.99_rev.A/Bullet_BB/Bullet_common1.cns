triggerall = vel Y > -1
triggerall = pos Y < 0
triggerall = alive
triggerall = canrecover
trigger1 = !AILevel
trigger1 = ((command = "recovery") && (command = "holdfwd") && (command != "holdback"))
value = 5211 ;HITFALL_AIRRECOVER

[State 5050, 4]; Recover in mid air (Backward)
