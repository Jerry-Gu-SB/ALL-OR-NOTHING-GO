;-------------------------------------------------------------------------------
;Rage Aggressor
[Statedef 3000]
type = S
movetype = A
physics = N
anim = 3000
sprpriority = 2
ctrl = 0

[State VarS, 1]
type = VarSet
trigger1 = time = 0
var(10) = 54
ignorehitpause = 1

[State VarS, 1]
type = VarSet
trigger1 = fvar(31) > 0
trigger1 = time = 0
var(54) = 1

[State PowerA, 1]
type = PowerAdd
trigger1 = time = 0
value = -1000

[State VarS, 1]
type = VarSet
trigger1 = time = 0
var(13) = 180

[State Turn, 1]
type = Turn
trigger1 = !time && p2dist X < 0 && (prevstateno = 52 || (prevstateno = [200,1999]))

[State AttackD, 1]
type = AttackDist
trigger1 = 1
value = 0

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = 0

[State VelS, 1]
type = VelSet
trigger1 = animelem = 18
x = 30

[State VarR, 1]
type = VarRandom
trigger1 = animelem = 2
v = 1
range = 0,1

[State PlayS, 1]
type = PlaySnd
trigger1 = animelem = 2
value = 3000, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State PlayS, 1]
type = PlaySnd
trigger1 = time = 0
value = 305, 0
volumescale = helper(9999),var(15)

[State Pause, 1]
type = Pause
trigger1 = time = 0
moveTime = 54
time = 54

[State VarS, 1];Rapid Cancel Reset
type = VarSet
trigger1 = time = 0
ignorehitpause = 1
var(20) = 0

[State Helper, 1]
type = Helper
trigger1 = time = 0
name = "Distortion_Effect"
ID = 7600
Stateno = 7600
pos = -20,-300
postype = p1
keyctrl = 0
ownpal = 1
pausemovetime = 9999999999*99
supermovetime = 9999999999*99
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)

[State ChangeS, 1]
type = ChangeState
trigger1 = animtime = 0
trigger2 = animelemtime(21) = 1
trigger2 = p2bodydist X <= 400
value = 3010

