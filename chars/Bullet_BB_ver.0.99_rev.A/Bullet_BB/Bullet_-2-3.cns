supermovetime = 9999999999*99

;Distortion Finish
[State Helper, 1]
type = Helper
triggerall = !ishelper
triggerall = winko
triggerall = roundstate != 4
triggerall = numenemy
triggerall = numhelper(7630) = 0
triggerall = numhelper(7640) = 0
trigger1 = enemynear,gethitvar(chainid) = 3000
trigger2 = enemynear,gethitvar(chainid) = 3100
ID = ifelse(var(54) = 1, 7640, 7630)
name = "Distortion_Finish!"
pos = 0,0
postype = back
stateno = ifelse(var(54) = 1, 7640, 7630)
keyctrl = 0
ownpal = 1
pausemovetime = 9999999999*99
supermovetime = 9999999999*99
