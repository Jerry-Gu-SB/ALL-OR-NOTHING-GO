[Info]
name = "Bullet_BB"
displayname = "Bullet"
versiondate = 6/03/2016
mugenversion = 1.0
author = "Ares"
pal.defaults = 1
localcoord = 1280,720;941,554
;Localcoord Values
;Please check your mugen.cfg in the data folder.
;Match the localcoord with your Mugen Configuration.
;Using different localcoords with different
;resolution will result in misplaced HUD and helpers.
;-----------------
;1280,720 - 1280x720 configuration (Default Resolution)
;941,554  - 640x480 configuration
;-----------------
;After setting the correct localcoord,
;view the -option.txt and at the Hi-Def Display
;variable, var(49), set it to the correct resolution.

;For Hi-Def Display (1280x720)
;In the .def, localcoord = 1280,720
;In -option.txt, var(49) = 1

;Standard Display is used by default.
;For Standard Display (640x480)
;In the .def, localcoord = 941,554
;In -option.txt, var(49) = 0

[Files]
sprite	= Bullet_BB_1.0.sff
sound	= Bullet_BB.snd
anim	= Bullet_BB.air
cmd	= Bullet_BB.cmd
cns	= Bullet_BB.cns
st	= Bullet_BB.cns
stcommon	= Bullet_common1.cns
st0	= Bullet_N.cns
st1	= Bullet_S.cns
st2	= Bullet_D_A.cns
st3	= Bullet_-2-3.cns
st4	= Bullet_option.cns
pal1	= color/Bullet_pal01.act
pal2	= color/Bullet_pal02.act
pal3	= color/Bullet_pal03.act
pal4	= color/Bullet_pal04.act
pal5	= color/Bullet_pal05.act
pal6	= color/Bullet_pal06.act
pal7	= color/Bullet_pal07.act
pal8	= color/Bullet_pal08.act
pal9	= color/Bullet_pal09.act
pal10	= color/Bullet_pal10.act
pal11	= color/Bullet_pal13.act
pal12	= color/Bullet_pal12.act

;Maps character selection buttons to palette numbers.
[Palette Keymap]
;Press button X to select palette 1, etc.
a = 1
b = 2
c = 3
x = 4
y = 5
z = 6
;Hold Start and press button X for palette 7, etc.
a2 = 7
b2 = 8
c2 = 9
x2 = 10
y2 = 11
z2 = 12

