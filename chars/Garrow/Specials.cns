;===========================================================================
; Scarlet Edge - Projectile (Helper Object)
;===========================================================================
[Statedef 1360]
type    = A
movetype= A
physics = N
anim    = 1360	; fireball animation ID
velset  = 6, 6  ; Default Speed (Light), Moves 6 pixels forward, moves 6 down

; --- Adjust projectile speed based on performed version ---
[State 1360, Medium Speed]
type = VelSet
trigger1 = Time = 0 && Parent, StateNo = 1316
x = 7.5
y = 7.5

[State 1360, Heavy / Charged Speed]
type = VelSet
trigger1 = Time = 0 && (Parent, StateNo = 1326 || Parent, StateNo = 1307 || Parent, StateNo = 1317 || Parent, StateNo = 1327)
x = 9
y = 9

; --- change sizing? ---
[State 1360, Charged Size Boost]
type = AngleDraw
trigger1 = Parent, StateNo = 1307 || Parent, StateNo = 1317 || Parent, StateNo = 1327
scale = 1.35, 1.35

; --- NORMAL HITDEF (Light, Medium, Heavy Uncharged) ---
[State 1360, HitDef Normal]
type = HitDef
trigger1 = Time = 0
trigger1 = Parent, StateNo != 1307 && Parent, StateNo != 1317 && Parent, StateNo != 1327
attr = A, SP
damage = ifelse(Parent, StateNo = 1326, 80, ifelse(Parent, StateNo = 1316, 70, 60)), 15
animtype = Medium
hitflag = MAF
guardflag = MA
pausetime = 8, 8
sparkno = -1
guard.sparkno = -1
ground.type = High
ground.slidetime = 14
ground.hittime = 14
ground.velocity = -5, 0
air.velocity = -4, -3

; --- CHARGED HITDEF (Knocks Down + Higher Damage) ---
[State 1360, HitDef Charged]
type = HitDef
trigger1 = Time = 0
trigger1 = Parent, StateNo = 1307 || Parent, StateNo = 1317 || Parent, StateNo = 1327
attr = A, SP
damage = 105, 25
animtype = Heavy
hitflag = MAF ; MHLAFD+-  medium(=HL), high, low, air, fall, down
guardflag = MA ; MHLAFD+-  default = empty / unguardable
pausetime = 8, 8
sparkno = -1
guard.sparkno = -1
ground.type = High
ground.slidetime = 18
ground.hittime = 18
ground.velocity = -6, -4
air.velocity = -6, -4
fall = 1

; --- EXPLOSION TRIGGERS ---
[State 1360, Hit Opponent Explosion]
type = ChangeState
trigger1 = MoveContact ; Explodes immediately when hitting or blocked by P2
value = 1365
ignorehitpause = 1

[State 1360, Hit Floor Explosion]
type = ChangeState
trigger1 = Pos Y >= 0 ; Explodes on contact with floor
value = 1365

;===========================================================================
; Scarlet Edge - Projectile Impact Explosion
;===========================================================================
[Statedef 1365]
type = S
movetype = I
physics = N
anim = 1255 ; explosion anim id
velset = 0, 0

[State 1365, Snap to Ground Surface] ; only occurs if near floor
type = PosSet
trigger1 = Time = 0 && Pos Y >= -10
y = 0 ; locks epxlosion sprite against floor

[State 1365, Delete Fireball Helper]
type = DestroySelf
trigger1 = AnimTime = 0 ; delete obj on anim end


;---------------------------------------------------------------------------
; EX Move Cut-In Helper [Statedef 6000]
[Statedef 6000]
type = A
movetype = I
physics = N
anim = 9999 ; using invis anim from .air file
ctrl = 0

[State 6000, EX Cut-In Effect]
type = Explod
trigger1 = Time = 0
anim = 7000 ; TODO: needs to be changed to Garrow's EX Cut in anim id
postype = left
; if TeamSide is 1, X is 0. If TeamSide is 2, X is the full screen width (ScreenWidth)
pos = ifelse(TeamSide = 1, 0, ScreenWidth), 200
; Faces right (1) for P1, faces left (-1) for P2
facing = ifelse(TeamSide = 1, 1, -1)
sprpriority = -1
ownpal = 1
ignorehitpause = 1
scale = 0.2,0.2
bindtime = -1 ; lock to viewport bounds 1 = default, -1 = infinite (until removetime)
removetime = 30 ; adjust as needed, 30 frames ≈ 0.5 second

[State 6000, EX Cut-In Background Effect]
type = Explod
trigger1 = Time = 0
anim = 7001
postype = left
pos = ifelse(TeamSide = 1, 0, ScreenWidth), 200
facing = ifelse(TeamSide = 1, 1, -1)
ownpal = 1
ignorehitpause = 1
sprpriority = -1
scale = 0.2,0.2
bindtime = -1 ; lock to viewport bounds
removetime = 30

[State 6000, Destroy Self]
type = DestroySelf
trigger1 = Time >= 30 ; clean up helper once cut-in finishes

