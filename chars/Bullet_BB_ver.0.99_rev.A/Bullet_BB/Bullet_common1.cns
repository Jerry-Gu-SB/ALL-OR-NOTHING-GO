value = 5500

;---------------------------------------------------------------------------
; Initialize (At the start of the round)
[Statedef 5900]
type = S

[State 5900, 1];Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2];Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Change palette
type = RemapPal
trigger1 = 1
source = 1,1
dest = 1,palno

[State 5900, 4] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;-------------------States here are for the AI only.------------------------
;-------------------These states control how the AI walks and jumps.--------
;-------------------State 21 the walking state.-----------------------------
;-------------------State 31 to State 39 are the jumping states.------------
;-------------------Because of these states, the AI can---------------------
;-------------------utilize movements with full control.--------------------
;-----------------------------Whatever you do..-----------------------------
;-------!!!!!!!!!!!!!!DO NOT REMOVE ANY OF THESE STATES!!!!!!!!!!!!!!-------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

;-------------------------------------------------------------------------------
;AI Walk
[Statedef 21]
type = S
physics = S
sprpriority = 0
ctrl = 0

[State ChangeS, 1]
type = ChangeState
triggerall = AILevel
triggerall = roundstate = 2
triggerall = random < AILevel*150 || AILevel > 7
triggerall = inguarddist
trigger1 = !(enemynear,HitDefAttr = SCA, NT, ST, HT)  || (enemy,numhelper > 0) || (enemy,numproj > 0)
value = 120

[State ChangeA, 1]
type = ChangeAnim
triggerall = anim != 5
trigger1 = p2dist X < 0
value = 5
persistent = 1

[State Turn, 1]
type = Turn
trigger1 = p2dist X < 0
persistent = 1

[State VelS, 1]
type = VelSet
trigger1 = p2statetype != L
trigger1 = p2movetype != H
trigger1 = p2bodydist X > 310
trigger2 = p2statetype = L
trigger2 = p2bodydist X > 100
trigger3 = p2movetype = H
trigger3 = p2bodydist X > 50
x = const(velocity.walk.fwd.x)

[State VelS, 1]
type = VelSet
trigger1 = p2statetype = L
trigger1 = p2bodydist X < 200
trigger2 = p2statetype != L
trigger2 = p2movetype != H
trigger2 = p2bodydist X < 290
x = const(velocity.walk.back.x)

[State VelS, 1]
type = VelSet
trigger1 = p2statetype != L
trigger1 = p2movetype != H
trigger1 = p2bodydist X = [290,310]
trigger2 = p2statetype = L
trigger2 = p2bodydist X = [200,220]
x = 0

[State ChangeA, 1]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = anim != 20 && anim != 5
trigger2 = anim = 5 && animtime = 0
value = 20

[State ChangeA, 1]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = anim != 21 && anim != 5
trigger2 = anim = 5 && animtime = 0
value = 21

[State ChangeA, 1]
type = ChangeAnim
triggerall = vel x = 0
trigger1 = anim != 0 && anim != 5
trigger2 = anim = 5 && animTime = 0
value = 0

[State VarR, 1]
type = VarRandom
trigger1 = anim = 5
trigger1 = animelem = 1
v = 2
range = 0,1

[State PlayS, 1]
type = PlaySnd
triggerall = roundstate = 2
trigger1 = anim = 5
trigger1 = animelem = 1
value = 5, var(2)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State PlayS, 1]
type = PlaySnd
trigger1 = anim = 20
trigger1 = animelem = 8
trigger2 = anim = 20
trigger2 = animelem = 11
trigger3 = anim = 21
trigger3 = animelem = 8
trigger4 = anim = 21
trigger4 = animelem = 10
value = 300, 0
volumescale = helper(9999),var(15)

[State ChangeS, 1]
type = ChangeState
trigger1 = !AILevel
value = 0
ctrl = 1

;-------------------------------------------------------------------------------
;AI Jump Start (610)
[Statedef 41]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State VarS, 1]
type = VarSet
trigger1 = time >= 0
var(16) = 1
ignorehitpause = 0

[State PlayS, 1]
type = PlaySnd
trigger1 = time = 3
value = 300, 0
volumescale = helper(9999),var(15)

[State VarS, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 1

[State VelS, 1]
type = VelSet
triggerall = var(3) = 0
trigger1 = prevstateno = 100
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.runjump.fwd.x), ifelse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State VelS, 1]
type = VelSet
triggerall = var(3) = 0
trigger1 = prevstateno = 101
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.walk.fwd.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State VelS, 1]
type = VelSet
triggerall = var(3) = 0
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State VelS, 1]
type = VelSet
triggerall = var(3) = 0
trigger1 = animtime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State VelS, 1]
type = VelSet
triggerall = time = 0
trigger1 = var(3) = 1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, (const(velocity.jump.fwd.x)+4.2), (const(velocity.jump.back.x)-4.2)))
y = -40

[State VelS, 1]
type = VelSet
trigger1 = time = 0
trigger1 = var(3) = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = -40

[State AfterI, 1]
type = AfterImage
trigger1 = helper(9999),var(28) = 0
trigger1 = var(3) >= 1
timegap = 1
framegap = 3
length = 15
time = -1
palcontrast = 120,120,120
palmul = 0.75,0.75,0.75
trans = add1

[State Explod, 1]
type = Explod
trigger1 = animtime = 0
anim = 7040
ID = 7040
postype = p1
sprpriority = 0
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = animtime = 0
anim = 7041
ID = 7040
postype = p1
sprpriority = 0
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = animtime = 0
anim = 7042
ID = 7040
postype = p1
sprpriority = 0
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State 40, 6]
type = ChangeState
trigger1 = var(3) = 0
trigger1 = animtime = 0
trigger2 = var(3) >= 1
trigger2 = time = 0
value = 50
ctrl = 1

