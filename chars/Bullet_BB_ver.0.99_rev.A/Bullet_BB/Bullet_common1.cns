triggerall = authorname = "Ares"
trigger1 = Time = 1
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = ifelse((!alive && (helper(9999),var(0) = 1)), 5400, (5047 + GetHitVar(animtype)));5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 2] ;Anim for HIT_BACK
