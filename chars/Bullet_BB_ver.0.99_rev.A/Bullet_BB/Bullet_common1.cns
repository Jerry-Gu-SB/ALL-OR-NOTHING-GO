;-------------------------------------------------------------------------------
;Stand Guard Hit (Shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State Helper, 1]
type = Helper
triggerall = var(21) = 1
triggerall = fvar(29) > 0
trigger1 = numhelper(7150) = 0
name = "Barrier"
ID = 7150
Stateno = 7150
pos = 0,0
postype = p1

[State VarA, 1]
type = VarAdd
trigger1 = time = 0
trigger1 = numhelper(7150) = 1
fvar(29) = ceil(-30-GetHitVar(damage)-abs(GetHitVar(ctrltime)*2)-abs(GetHitVar(animtype)*2)-abs(GetHitVar(hitshaketime)*2))
ignorehitpause = 1
persistent = 0

[State 150, 0]
type = ChangeState
triggerall = time = 0
trigger1 = statetype = A
trigger2 = pos Y < 0
value = 154

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150 + ((statetype = S && var(6))*3)

[State VarS, 1]
type = VarSet
trigger1 = time = 0
var(50) = 0

[State VarS, 1]
type = VarSet
trigger1 = time = 0
trigger1 = var(21) = 1
var(50) = 1

[State -2]
type = VarSet
trigger1 = time = 0
trigger1 = var(50) = 1
fvar(16) = GetHitVar(slidetime)

[State -2]
type = VarSet
trigger1 = time = 0
trigger1 = var(50) = 1
fvar(17) = hitvel X

[State -2]
type = VarSet
trigger1 = enemy,numproj = 0
trigger1 = enemy,HitDefAttr = SCA,NA,SA,HA
trigger1 = 1
fvar(18) = 1

[State -2]
type = VarSet
trigger1 = enemy,numproj != 0
trigger1 = 1
fvar(18) = 0

[State Helper, 1]
type = Helper
trigger1 = var(50) = 1
trigger1 = fvar(18) = 1
name = "Barrier_Pushback"
ID = 7151
Stateno = 7151
persistent = 0
pos = 50,0
postype = p2

[State VarS, 1];Instant Guard Pushback
type = VarSet
trigger1 = time = 0
fvar(19) = 1
ignorehitpause = 1
persistent = 0

[State VarS, 1];Instant Guard Pushback
type = VarSet
triggerall = time = 0
trigger1 = var(23) > 22
fvar(19) = 0.5
ignorehitpause = 1
persistent = 0

[State VarS, 1];Instant Guard Blockstun
type = VarSet
triggerall = !hitshakeover
trigger1 = time = 0
var(23) = (GetHitVar(ctrltime) + var(50))
ignorehitpause = 1
persistent = 0

[State VarS, 1];Instant Guard Blockstun
type = VarSet
triggerall = !hitshakeover
trigger1 = time = 0
trigger1 = var(22) > 22
var(23) = cond(var(23) - 5 > 0, var(23) - 5, 0)
ignorehitpause = 1
persistent = 0

[State 150, 3]
type = ChangeState
trigger1 = !AILevel
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, 3]
type = ChangeState
trigger1 = AILevel
trigger1 = HitShakeOver
value = 151 + 2*(fvar(38) = 1)

[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = !AILevel
trigger1 = statetype != A
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = !AILevel
trigger1 = statetype != A
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

