;Jumping Light
[Statedef 600]
type = A
movetype= A
physics = A
ctrl = 0
anim = 600
sprpriority = 2
poweradd = 20
juggle = 1

[State 600, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 0,3

[State 600, CtrlSet] 
type = CtrlSet
trigger1 = var(1)
trigger1 = animelem = 5 ;Have control in the air after the attack. Add fall frames on EVERY air normal.
value = 1

[State 600, HitDef]
type = HitDef
trigger1 = !var(1) && animelem = 2
attr = A,NA
hitflag = MAF
guardflag = HA
animtype = Light
damage = 30,0
getpower = 20,0
givepower = 20,0
pausetime = 8,7
guard.pausetime = 8,7
sparkNo= s8010
guard.sparkNo=-1 + 0 * (var(34) := 8000)
sparkXY=-10 + 0 * (var(35) := 70), var(36):=-110 
hitsound = S1,1
guardsound = S6,0
ground.type = High
ground.slidetime = 8
ground.hittime = 16 + 2 * var(9)
air.hittime = 12
ground.velocity = -3.5,0
ground.cornerpush.veloff = -8
air.velocity = 0,-9
airguard.velocity = -6,-2
fall.xvelocity = 0
fall.yvelocity = -2
air.fall = 1
fall.recover = 0

;Jumping Heavy
[Statedef 610]
type = A
movetype= A
physics = N
ctrl = 0
anim = 610
sprpriority = 2
poweradd = 50
juggle = 1
[State 610, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 0,4

[State 0, Vel]
type = velset
trigger1 = prevstateno = 600
trigger1 = animelem=2
x = 1
y = 1

[State 610, CtrlSet]
type = CtrlSet
trigger1 = var(1)
trigger1 = animelem = 6
value = 1

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = .6

[State 610, ChangeState]
type = ChangeState
trigger1 = pos y >= 0 && vel y > 0
value = cond(MoveContact, 52, 611) ; should go to 611 if no contact, and 52 if contact


[State 610, HitDef]
type = HitDef
trigger1 = !var(1) && animelem = 3
attr = A,NA
hitflag = MAF
guardflag = HA
animtype = Medium
damage = 36,0
getpower = 30,0
givepower = 20,0
pausetime = 8,7
guard.pausetime = 8,7
sparkNo= s8010
guard.sparkNo=-1 + 0 * (var(34) := 8000)
sparkXY=-10 + 0 * (var(35) := 70), var(36):=-110 
hitsound = S1,18
guardsound = S6,0
ground.type = High
ground.slidetime = 20
guard.slidetime = 20
ground.hittime = 18 + 4*var(9)
guard.hittime =18
air.hittime = 19
ground.cornerpush.veloff = -8
yaccel = .53
ground.velocity = -5,0
air.velocity = 0,-6
airguard.velocity = -6,-2
fall.xvelocity = 0
fall.yvelocity = -2
air.fall = 1
fall.recover = 0
id = 1

[State 610, HitDef]
type = HitDef
trigger1 = var(1) && animelem = 3
attr = A,NA
hitflag = MAF
guardflag = HA
animtype = Medium
damage = 36,0
getpower = 30,0
givepower = 20,0
pausetime = 8,7
guard.pausetime = 8,7
sparkno = S8001
guard.sparkno = S8050
sparkxy = -10, -76* const(size.yscale)
hitsound = S5,1
guardsound = S6,0
ground.type = High
ground.slidetime = 10
ground.cornerpush.veloff = 0
ground.hittime = 12
air.hittime = 12
yaccel = ifelse(vel y<-4,.82,.53)
ground.velocity = -5,0
air.velocity = 0,ifelse(vel y<-4,vel y,-4)
airguard.velocity = -6,-2
fall.xvelocity = 0
fall.yvelocity = -2
air.fall = 1
fall.recover = 0
id = 1


; 610 whiff state
;---------------------------------------------------------------------------
; Heavy Splat
[Statedef 611]
type    = L
movetype= H
physics = N
velset = 0,0

[State 611, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 611, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 611, Pos Set]
type = PosSet
trigger1 = 1
y = 0

[State 611, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = 1
value = 611

[State 611,2]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1



