;-------------------------------------------------------------------------------
;Burst HUG Main
[State Explod, 1]
type = Explod
trigger1 = time >= 0
trigger1 = numexplod(7250) = 0
trigger1 = root,fvar(30) >= 10000
anim = 7250
ID = 7250
postype = left
pos = ifelse(facing = 1, (84+ (helper(9999),var(54))), (GameWidth - 84 + (helper(9999),var(54)))), 144 + (helper(9999),var(55))
bindtime = -1
