;-------------------------------------------------------------------------------
;3000 (3rd) Hit Shake
[Statedef 6480]
type = A
movetype = H
physics = N
velset = 0,0

[State PosS, 1]
type = PosSet
trigger1 = pos Y > 0
y = 0

[State ChangeA, 1]
type = ChangeAnim
triggerall = authorname = "Ares"
trigger1 = selfanimexist(5430)
value = 5430

[State ChangeA, 1]
type = ChangeAnim
triggerall = authorname = "Ares"
trigger1 = !selfanimexist(5430)
value = 5030

[State ChangeA, 1]
type = ChangeAnim
trigger1 = authorname != "Ares"
trigger1 = time = 0
trigger1 = gethitvar(animtype) = [3,5]
trigger2 = authorname = "Ares"
trigger2 = !selfanimexist(5430)
trigger2 = time = 0
trigger2 = gethitvar(animtype) = [3,5]
value = ifelse((gethitvar(animtype) = [4,5]), (ifelse(selfanimexist(5047 + gethitvar(animtype)), 5047 + gethitvar(animtype), 5030)), 5030)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = authorname != "Ares"
trigger1 = time = 0
trigger1 = (gethitvar(animtype) = [4,5]) && (selfanimexist(5047 + gethitvar(animtype)))
trigger2 = authorname = "Ares"
trigger2 = !selfanimexist(5430)
trigger2 = time = 0
trigger2 = (gethitvar(animtype) = [4,5]) && (selfanimexist(5047 + gethitvar(animtype)))
value = 5047 + gethitvar(animtype)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time > 0
value = anim

[State PlayerP, 1]
type = PlayerPush
