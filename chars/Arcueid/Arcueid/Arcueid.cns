anim = 171
scale = .3,.3
postype = p1
facing = 1
vfacing = 1
pos = 0,0
sprpriority = 5
ownpal = 1
bindtime = -1
ignorehitpause = 1
persistent = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
