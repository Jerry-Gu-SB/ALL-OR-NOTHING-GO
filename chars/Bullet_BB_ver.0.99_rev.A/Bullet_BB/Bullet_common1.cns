[State 5101, 6] ;Acceleration
type = VelAdd
trigger1 = 1
y = Const(movement.down.bounce.yaccel)

[State 5101, 7] ;Hit ground
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= Const(movement.down.bounce.groundlevel)
value = 5110

;-------------------------------------------------------------------------------
;Hit Lie Down
[Statedef 5110]
type    = L
movetype= H
physics = N
ctrl = 0

[State HitB, 1]
type = HitBy
trigger1 = 1
value = SCA, AA, AP
persistent = 1

[State PlayS, 1]
type = PlaySnd
triggerall = (authorname = "Ares")
trigger1 = time = 0
trigger1 = prevstateno = 5402
value = 300, 10
volumescale = helper(9999),var(15)

[State VarS, 1]
type= VarSet
trigger1 = time = 1
trigger1 = prevstateno = 5402
var(0) = random%2

[State Explod, 1]
type = Explod
trigger1 = time = 1
trigger1 = var(0) = 0
trigger1 = prevstateno = 5402
anim = 7052
ID = 7052
postype = p1
sprpriority = -1
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = time = 1
trigger1 = var(0) = 0
trigger1 = prevstateno = 5402
anim = 7053
ID = 7053
postype = p1
sprpriority = -2
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = time = 1
trigger1 = var(0) = 1
trigger1 = prevstateno = 5402
anim = 7052
ID = 7052
postype = p1
sprpriority = -1
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = time = 1
trigger1 = var(0) = 1
trigger1 = prevstateno = 5402
anim = 7053
ID = 7053
postype = p1
sprpriority = -2
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State 5110, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5110, 1] ;For hit Trip/Custom anim
type = ChangeAnim
;persistent = 0
trigger1 = prevstateno = 5071
;trigger1 = anim = [5081,5089]
trigger2 = prevstateno = 5402
trigger3 = anim = 5432
trigger4 = anim = 5401
trigger5 = anim = 5111
value = 5111

[State 5110, 1] ;For hit up/up-diag type (from state 5081)
type = ChangeAnim
;persistent = 0
trigger1 = prevstateno != 5071
trigger1 = SelfAnimExist(5110 + (anim % 10))
trigger1 = anim = [5081,5089]
value = 5110 + (anim % 10)

[State 5110, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170

[State 5110, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim = [5161,5169]
trigger1 = SelfAnimExist(5170 + (anim % 10))
value = 5170 + (anim % 10)

[State 5110, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 5110, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5110, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 5110, 7]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5110, 8] ;For hit trip type
type = ChangeAnim
persistent = 0
triggerall = anim = 5071
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5111

[State 5110, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = animtime = 0
;trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5110 + (anim % 10)

[State 5110, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = anim != [5111,5119]
trigger1 = animTime = 0
;trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110

[State 5110, 11] ;If just died
type = ChangeState
triggerall = !alive
trigger1 = AnimTime = 0
;trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger2 = Anim = [5110,5119]
value = 5150

[State 5110, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = time = 0
sysvar(0) = 0

[State 5110, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5110, 14] ;Friction
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State ChangeS, 1]
type = ChangeState
trigger1 = anim = [5110,5111]
trigger1 = animtime = 0
value = 5120
ctrl = 0

;-------------------------------------------------------------------------------
;Hit Get Up
[Statedef 5120]
type    = L
movetype= I
physics = N

[State StateTypeS]
type = StateTypeSet
trigger1 = anim = 5120 || anim = 5121
statetype = S
movetype = I
physics = S

[State ChangeA, 1]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != 5111
trigger1 = anim != 5171
value = 5110

[State ChangeA, 1]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = 5111
trigger2 = anim = 5171
value = 5111

[State 5120, 1a] ;Get up anim (Face Up)
type = ChangeAnim
triggerall = anim = 5110
triggerall = time >= 20
trigger1 = time >= 50
trigger2 = !AILevel
trigger2 = command = "holddown"
trigger2 = command = "recovery"
value = 5120
elem = 1

[State 5120, 1b] ;Get up anim (Face Down)
type = ChangeAnim
triggerall = anim = 5111
triggerall = time >= 20
trigger1 = time >= 50
trigger2 = !AILevel
trigger2 = command = "holddown"
trigger2 = command = "recovery"
value = 5121
elem = 1

[State 5120, 2]
type = VelSet
trigger1 = Time = 0
x = 0

;[State 5120, 3]
;type = NotHitBy
;trigger1 = 1
;value = SCA
;time = 1

;[State 5120, 4]
;type = HitFallSet
;trigger1 = AnimTime = 0
;value = 1

;[State 5120, 5] ;Can't be thrown right after getting up
;type = NotHitBy
;trigger1 = AnimTime = 0
;value = , NT,ST,HT
;time = 12

;[State 5120, 6] ;Can't be hit right after getting up (short time)
;type = NotHitBy
;trigger1 = AnimTime = 0
;value2 = SCA
;time = 3

[State VarR, 1]
type = VarRandom
trigger1 = animelem = 1
v = 1
range = 0,1

[State PlayS, 1]
type = PlaySnd
trigger1 = anim = 5120
trigger1 = animelem = 1
value = 5120, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State PlayS, 1]
type = PlaySnd
trigger1 = anim = 5121
trigger1 = animelem = 1
value = 5121, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State 5120, 7]
type = ChangeState
triggerall = anim = 5120 || anim = 5121
trigger1 = animtime = 0
value = 0
ctrl = 1

;-------------------------------------------------------------------------------
;Hit Lie Dead
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3

[State ScreenB, 1]
type = ScreenBound
trigger1 = 1
value = 0

[State ChangeA, 1] ;For hit Trip/Custom anim
type = ChangeAnim
trigger1 = prevstateno = 5402
value = 5111

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, 4] ;Match over anim
type = ChangeAnim
persistent = 0
;trigger1 = Time = 0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim != [5140,5159]
trigger1 = anim != [5110,5119]
value = 5110

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = vel X < .05
persistent = 0
x = 0

[State PosS, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State VelS, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State FallEnvS, 1]
type = FallEnvShake
trigger1 = time = 0
trigger1 = prevstateno = 5402

[State PlayS, 1]
type = PlaySnd
triggerall = (authorname = "Ares")
trigger1 = time = 0
trigger1 = prevstateno = 5402
value = 300, 10
volumescale = helper(9999),var(15)

[State VarS, 1]
type= VarSet
trigger1 = time = 1
trigger1 = prevstateno = 5402
var(0) = random%2

[State Explod, 1]
type = Explod
trigger1 = time = 1
trigger1 = var(0) = 0
trigger1 = prevstateno = 5402
anim = 7052
ID = 7052
postype = p1
sprpriority = -4
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = time = 1
trigger1 = var(0) = 0
trigger1 = prevstateno = 5402
anim = 7053
ID = 7053
postype = p1
sprpriority = -5
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
