;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, RandomWinPose]
type = ChangeAnim
trigger1 = Time = 0
value = IfElse(Random>=0&&Random<333,180,IfElse(Random>=333&&Random<666,181,180))

[State 180, Sound]
type = PlaySnd
trigger1 = anim = 180
trigger1 = animelem = 3
value = S191, 0
volume = 255

[State 180, Sound]
type = PlaySnd
trigger1 = anim = 181
trigger1 = animelem = 3
value = S190, 0
volume = 255

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0 && time = 0
value = IfElse(Random>=0&&Random<333,190,IfElse(Random>=333&&Random<666,191,192))

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 180, Sound]
type = PlaySnd
trigger1 = anim = 190
trigger1 = animelem = 4
value = S180, 0
volume = 255

[State 180, Sound]
type = PlaySnd
trigger1 = anim = 192
trigger1 = animelem = 8
value = S6002, 0
volume = 255

;[State 180, Sound]
;type = PlaySnd
;trigger1 = anim = 191
;trigger1 = animelem = 2
;value = S180, 0
;volume = 255

