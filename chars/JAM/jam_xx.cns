trigger1 = time = 0
trigger1 = sysvar(2) != [5080,5082]
sysvar(2) = 5030

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

[State 5080, 4]
