[State ChangeA, 1]
type = ChangeAnim
triggerall = !hitshakeover
trigger1 = (authorname = "Ares")
value = ifelse(selfanimexist(5071), 5071, ifelse(selfanimexist(5101), 5101, 5100))

[State ScreenB, 1]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State PosS, 1]
type = PosSet
trigger1 = !hitshakeover
y = 0

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = 0
y = 0

[State EnvS, 1]
type = EnvShake
trigger1 = time = 0
time = 20
freq = 90
ampl = 4

[State ChangeS, 1]
type = ChangeState
trigger1 = hitshakeover
value = 3114

