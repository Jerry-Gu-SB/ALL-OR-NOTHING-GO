movetype = H
physics = N
velset = 0,0
ctrl = 0

[State NotHitB, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AP, AT
ignorehitpause = 1

[State HitB, 1]
type = HitBy
triggerall = enemynear,name = "Bullet_BB"
trigger1 = enemynear,ctrl = 1
trigger2 = enemynear,stateno = 2200
trigger3 = enemynear,stateno = 2210
trigger4 = enemynear,stateno = 3110
trigger4 = enemynear,animelemtime(7) >= 0
value = SCA, AA, AP, AT
persistent = 1

[State VarS, 1];Stagger Recovery
type = VarSet
trigger1 = time = 0
sysvar(4) = gethitvar(hittime) + gethitvar(hitshaketime)

[State PosS, 1]
type = PosSet
trigger1 = time = 0
y = 0

[State ChangeA, 1];Default Anim
type = ChangeAnim
triggerall = time = 0
trigger1 = name != "Ares_BB"
trigger2 = name != "Itsumi_BB"
trigger3 = name != "Delta-4"
trigger4 = name != "Epsilon-5"
trigger5 = name != "Platinum_BB"
trigger6 = name != "Bullet_BB"
value = 5012

[State ChangeA, 1];Custom Anim
type = ChangeAnim
triggerall = time = 0
trigger1 = name = "Ares_BB"
trigger2 = name = "Itsumi_BB"
trigger3 = name = "Delta-4"
trigger4 = name = "Epsilon-5"
trigger5 = name = "Platinum_BB"
trigger6 = name = "Bullet_BB"
value = 5400

[State ChangeAnim, 1];Freeze anim
type = ChangeAnim
trigger1 = time >= 0
value = anim

[State VarR, 1]
type = VarRandom
triggerall = (authorname = "Ares")
triggerall = alive
triggerall = time = 0
trigger1 = name = "Ares_BB"
trigger2 = name = "Itsumi_BB"
trigger3 = name = "Delta-4"
trigger4 = name = "Epsilon-5"
trigger5 = name = "Platinum_BB"
trigger6 = name = "Bullet_BB"
v = 1
range = 0,1

[State PlayS, 1]
type = PlaySnd
triggerall = (authorname = "Ares")
triggerall = alive
triggerall = time = 0
trigger1 = name = "Ares_BB"
trigger2 = name = "Itsumi_BB"
trigger3 = name = "Delta-4"
trigger4 = name = "Epsilon-5"
trigger5 = name = "Platinum_BB"
trigger6 = name = "Bullet_BB"
value = 5400, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State ChangeS, 1]
type = ChangeState
trigger1 = hitshakeover
value = 3112

;-------------------------------------------------------------------------------
;3110 (1st) Hit Stagger (Slide)
[Statedef 3112]
type = S
movetype = H
physics = N

[State NotHitB, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AP, AT
ignorehitpause = 1

[State HitB, 1]
type = HitBy
triggerall = enemynear,name = "Bullet_BB"
trigger1 = enemynear,ctrl = 1
trigger2 = enemynear,stateno = 2200
trigger3 = enemynear,stateno = 2210
trigger4 = enemynear,stateno = 3110
trigger4 = enemynear,animelemtime(7) >= 0
value = SCA, AA, AP, AT
persistent = 1

[State VarA, 1];For Stagger Recovery
type = VarAdd
trigger1 = time > 0
trigger1 = sysvar(4) > 0
sysvar(4) = -1

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = gethitvar(xvel) * facing

[State VelM, 1];Stop sliding back
type = VelMul
trigger1 = 1
x = .88

[State SelfS, 1]
type = SelfState
triggerall = alive
triggerall = anim = 5400
triggerall = sysvar(4) = 0
triggerall = command = "recovery"
trigger1 = name = "Ares_BB"
trigger2 = name = "Itsumi_BB"
trigger3 = name = "Delta-4"
trigger4 = name = "Epsilon-5"
trigger5 = name = "Platinum_BB"
trigger6 = name = "Bullet_BB"
value = 5405
ctrl = 0

[State SelfS, 1]
type = SelfState
triggerall = anim = 5400
triggerall = sysvar(4) <= 0
trigger1 = name = "Ares_BB"
trigger2 = name = "Itsumi_BB"
trigger3 = name = "Delta-4"
trigger4 = name = "Epsilon-5"
trigger5 = name = "Platinum_BB"
trigger6 = name = "Bullet_BB"
value = 5402
ctrl = 0

[State ChangeAnim, 1]
type = ChangeAnim
triggerall = anim != 5400
trigger1 = animtime = 0
value = 5017

[State SelfS, 1]
type = SelfState
triggerall = anim != 5400
trigger1 = sysvar(4) <= 0
value = 5100
ctrl = 0

