;===========================================================================
; 214A - Scarlet Edge (Light Ground Version)
;===========================================================================
[Statedef 1300]
type = S
movetype = A
physics = N
ctrl = 0
anim = 1300 ; set to match air launch anim
velset = 0,0

[State 1300, Launch velocity]
type = VelSet
trigger1 = Time = 0
x = 4.5 ; move forward slightly into leap
y = -8.5 ; vertical launch upwards

[State 1300, Change to Air State]
type = StateTypeSet
trigger1 = Time = 2
statetype = A ; change to airborne
physics = A ; enable gravity to fall

[State 220, Stop]
type = VelSet
trigger1 = P2Dist X <= 15
x = 0

[State 1300, Auto-Fireball at Jump Apex]
type = ChangeState
trigger1 = Vel Y > 0 ; trigger upon fall
value = 1305 ; shift into air fireball state 
ctrl = 0 ; keeping control locked to execute attack automatically

;===========================================================================
; j.214A - Start - Charge Check
;===========================================================================
[Statedef 1305]
type = A
movetype = A
physics = A             ; Keep normal air gravity & jump momentum active!
ctrl = 0
anim = 1305             ; Charge/wind-up animation
; NO velset = 0, 0 here so momentum carries over

; --- HALT MOMENTUM ONCE CHARGED (At Frame 25) ---
[State 1305, Freeze Momentum When Charged]
type = VelSet
trigger1 = Time = 15
x = 0
y = 0

[State 1305, Disable Gravity When Charged]
type = StateTypeSet
trigger1 = Time = 15
physics = N             ; Locks character in mid-air while holding full charge

[State 1305, Full Charge Flash]
type = PalFX
trigger1 = Time = 15
time = 8
add = 120, 120, 40
ignorehitpause = 1

[State 1305, Full Charge Sound]
type = PlaySnd
trigger1 = Time = 15
value = 3000, 1

; --- LANDING SAFETY CHECK (In case they hit the floor before Time = 25) ---
[State 1305, Land While Charging Early]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 52              ; Standard landing state

; --- BRANCHING ---
; Branch 1: Released early -> Uncharged Fireball (Keeps Moving)
[State 1305, Release Uncharged]
type = ChangeState
triggerall = Time >= 2
trigger1 = command != "HOLD_A"
trigger1 = Time < 15
value = 1306

; Branch 2: Held past threshold -> Charged Fireball (Stays Frozen)
[State 1305, Release Charged]
type = ChangeState
trigger1 = command != "HOLD_A" && Time >= 15
trigger2 = Time >= 25
value = 1307

;===========================================================================
; j.214A - Uncharged Light Fireball (Maintains Jump Arc)
;===========================================================================
[Statedef 1306]
type = A
movetype = A
physics = A             ; Continues natural falling/forward momentum
ctrl = 0
anim = 1305
; Note: NO velset = 0, 0 

[State 1306, Spawn Normal Fireball]
type = Helper
trigger1 = AnimElem = 3
helpertype = Normal
name = "Scarlet Edge Fireball Light"
ID = 1360
stateno = 1360
pos = 70, -40
postype = p1
keyctrl = 0
ownpal = 1

; Land immediately if the jump arc touches the ground before AnimTime = 0
[State 1306, Land Early]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 52

[State 1306, Back to Jump Fall]
type = ChangeState
trigger1 = AnimTime = 0
value = 45
ctrl = 1

;===========================================================================
; j.214A - Charged Light Fireball (Halt Mid-Air Momentum)
;===========================================================================
[Statedef 1307]
type = A
movetype = A
physics = N             ; Gravity stays disabled during the charged throw
ctrl = 0
anim = 1305
velset = 0, 0           ; Guarantees zero movement during charged release

[State 1307, Charged Release Flash]
type = PalFX
trigger1 = Time = 0
time = 12
add = 80, 20, 20

[State 1307, Spawn Charged Fireball]
type = Helper
trigger1 = AnimElem = 3
helpertype = Normal
name = "Scarlet Edge Charged Fireball"
ID = 1360
stateno = 1360
pos = 70, -40
postype = p1
keyctrl = 0
ownpal = 1

[State 1307, Restore Gravity]
type = StateTypeSet
trigger1 = AnimTime = 0
physics = A             ; Re-enables gravity right as the throw finishes

[State 1307, Back to Jump Fall]
type = ChangeState
trigger1 = AnimTime = 0
value = 45
ctrl = 1

;===========================================================================
; 214B - Scarlet Edge (Medium Ground Version)
;===========================================================================
[Statedef 1310]
type = S
movetype = A
physics = N
ctrl = 0
anim = 1310 ; set to match air launch anim
velset = 0,0

[State 1310, Launch velocity]
type = VelSet
trigger1 = Time = 0
x = 4.5 ; move forward slightly into leap
y = -10.0 ; vertical launch upwards

[State 220, Stop]
type = VelSet
trigger1 = P2Dist X <= 15
x = 0

[State 1310, Change to Air State]
type = StateTypeSet
trigger1 = Time = 2
statetype = A ; change to airborne
physics = A ; enable gravity to fall

[State 1310, Auto-Fireball at Jump Apex]
type = ChangeState
trigger1 = Vel Y > 0 ; trigger upon fall
value = 1315 ; shift into air fireball state 
ctrl = 0 ; keeping control locked to execute attack automatically

;===========================================================================
; j.214B - Start - Charge Check (Saves Momentum on Entry)
;===========================================================================
[Statedef 1315]
type = A
movetype = A
physics = N             ; Turns off gravity so character floats immediately
ctrl = 0
anim = 1304
; Note: Do NOT put velset = 0, 0 in the Statedef header, or it will erase Vel X/Y before Time = 0!

; --- store jump momentum before freezing ---
[State 1315, Save Horizontal Momentum]
type = VarSet
trigger1 = Time = 0
fv = 1
value = Vel X

[State 1315, Save Vertical Momentum]
type = VarSet
trigger1 = Time = 0
fv = 2
value = Vel Y

; --- freeze velocity to float in place ---
[State 1315, Halt Momentum]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

; --- small float hover bob ---
[State 1315, Hover Bob Motion]
type = VelSet
trigger1 = Time >= 1
x = 0
y = 0.35 * sin(Time * 0.15)

; --- indicator full charge (At Frame 25) ---
[State 1315, Full Charge Flash]
type = PalFX
trigger1 = Time = 25
time = 8
add = 120, 120, 40
ignorehitpause = 1

[State 1315, Full Charge Sound]
type = PlaySnd
trigger1 = Time = 25
value = 3000, 1

; --- BRANCHING ---
; Branch 1: Released early -> Uncharged Fireball (Restores Jump Momentum)
[State 1315, Release Uncharged]
type = ChangeState
triggerall = Time >= 2
trigger1 = command != "HOLD_B"
trigger1 = Time < 25
value = 1316

; Branch 2: Held past threshold -> Charged Fireball (Stays Frozen)
[State 1315, Release Charged]
type = ChangeState
trigger1 = command != "HOLD_B" && Time >= 25
trigger2 = Time >= 60 ; (max hold time 1 second)
value = 1317

; --- LANDING SAFETY CHECK ---
[State 1315, Land While Charging]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 2
value = 52

;===========================================================================
; j.214B - Uncharged Medium Fireball 
;===========================================================================
[Statedef 1316]
type = A
movetype = A
physics = A             ; Re-enables normal air gravity
ctrl = 0
anim = 1315

; --- restore saved jump momentum ---
[State 1316, Restore Jump Arc]
type = VelSet
trigger1 = Time = 0
x = fvar(1)
y = fvar(2)

[State 1316, Spawn Medium Fireball]
type = Helper
trigger1 = AnimElem = 3
helpertype = Normal
name = "Scarlet Edge Fireball Medium"
ID = 1360
stateno = 1360
pos = 70, -40
postype = p1
keyctrl = 0
ownpal = 1

[State 1316, Land Early]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 52

[State 1316, Back to Jump Fall]
type = ChangeState
trigger1 = AnimTime = 0
value = 45
ctrl = 1

