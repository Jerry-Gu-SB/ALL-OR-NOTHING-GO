;----------------------------------------------------
;----------------------------------------------------
;----------------------------------------------------
;-----------------------Option-----------------------
;----------------------------------------------------
;----------------------------------------------------
;----------------------------------------------------

[Statedef 9999]
anim = 9999
ctrl = 0

[State AssertS, 1]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2 = noshadow

[State BindToR]
type = BindToRoot
trigger1 = 1
time = -1
pos = 0,-20

;-------------------------------------------------------------------------------
;Sound Settings

;Language
[State VarS, 1]
type = VarSet
trigger1 = 1
var(56) = 1
;Japanese = 0, English = 1
;Default = 0

;Voice Volume
[State VarS, 1]
type = VarSet
trigger1 = 1
var(14) = 100;100
;min 0, max 100, Default 100

;Sound Effect Volume
[State VarS, 1]
type = VarSet
trigger1 = 1
var(15) = 100;100
;min 0, max 100, Default 100

;-------------------------------------------------------------------------------
;Gameplay

;Astral Heat Round Count
[State VarS, 1]
type = VarSet
trigger1 = 1
var(50) = 2
;Enter Rounds to win to activate Astral Heat.
;Enter the number in match.wins in the fight.def.

;Astral BGM
[State VarS, 1]
type = VarSet
trigger1 = 1
var(41) = 1
;Off = 0, On = 1
;Default = 1

;Hi-Def Display
[State VarS, 1]
type = VarSet
trigger1 = 1
;This variable applies applies to various helpers and explods of this character.
;Currently, it only affects the camera helpers.

;Check your mugen.cfg under [Config] and check these two lines.
; GameWidth = (value)
; GameHeight = (value)
; 1280x720   High definition 16:9
;  640x480   Standard definition 4:3
;Set the variable to 0 when your GameWidth and GameHeight are 1280 and 720.
;Set the variable to 1 when your GameWidth and GameHeight are 640 and 480.

;WARNING: Setting the wrong display option with the wrong GameWidth/GameHeight
;of your settings will result to various helpers and explods being misplaced
;on screen.
;The character is made only for High definition (1280x720) display
;and Standard definition (640x480) display only.

var(49) = 0
;(720p) = 0, (480p) = 1
;Default = 0

;-------------------------------------------------------------------------------
;Middle of Screen
[State VarS, 1]
type = VarSet
trigger1 = 1
var(48) = ceil(GameWidth / 2) - 100

;-------------------------------------------------------------------------------
;Revolver Acton Cancel Variable !!Do not remove!!

;Revolver Action Canceller (Stops Infinite 200/400) Reset
[State VarS, 1]
type = VarSet
triggerall = var(1) != 0
trigger1 = root,ctrl = 1
trigger2 = root,movetype = H
ignorehitpause = 1
persistent = 1
v = 1
value = 0

;Revolver Action Canceller (Stops Infinite 200/400)
[State VarA, 1]
type = VarAdd
triggerall = var(1) < 3
trigger1 = root,time = 1
trigger1 = root,stateno = 200
trigger2 = root,time = 1
trigger2 = root,stateno = 400
var(1) = 1
ignorehitpause = 1

;6D / 2D Hit Confirm Reset
[State VarS, 1]
type = VarSet
triggerall = var(2) != 0
trigger1 = root,stateno = 0
trigger1 = root,time > 1
trigger2 = root,movetype = H
ignorehitpause = 1
persistent = 1
v = 2
value = 0

;6D / 2D Hit Confirm
[State VarA, 1]
type = VarAdd
triggerall = var(2) = 0
trigger1 = root,stateno = 238
trigger1 = root,movehit
trigger2 = root,stateno = 434
trigger2 = root,movehit
var(2) = 1
ignorehitpause = 1

;-------------------------------------------------------------------------------
;Stagger KO !!Do not remove!!
[State VarS, 1]
type = VarSet
triggerall = root,movetype = H
triggerall = root,stateno = [5000,5010]
trigger1 = enemynear,HitDefAttr = S, NA, NP
trigger2 = enemynear,HitDefAttr = C, NA, NP
trigger3 = enemynear,HitDefAttr = A, NA, NP
var(0) = 1

;Stagger KO !!Do not remove!!
[State VarS, 1]
type = VarSet
triggerall = root,movetype = H
triggerall = root,stateno = [5000,5010]
trigger1 = enemynear,HitDefAttr = S, SA, SP
trigger2 = enemynear,HitDefAttr = S, HA, HP
trigger3 = enemynear,HitDefAttr = C, SA, SP
trigger4 = enemynear,HitDefAttr = C, HA, HP
trigger5 = enemynear,HitDefAttr = A, SA, SP
trigger6 = enemynear,HitDefAttr = A, HA, HP
var(0) = 2

;Stagger KO !!Do not remove!!
[State VarS, 1]
type = VarSet
trigger1 = root,movetype != H
var(0) = 0

;-------------------------------------------------------------------------------
;Heat Up Level
[State VarS, 1]
type = VarSet
trigger1 = root,roundstate = 1
trigger2 = var(29) = 900
var(28) = 0

;Heat Up Max
[State VarS, 1]
type = VarSet
trigger1 = var(28) > 2
var(28) = 2

;Heat Up Level Reset
[State VarS, 1]
type = VarSet
triggerall = root,fvar(31) = 0
triggerall = var(28) > 0
triggerall = root,movetype != H
trigger1 = (root,prevstateno = 1010) && (root,stateno != 1010)
trigger2 = (root,prevstateno = [1250,1265]) && (root,stateno != 1250) && (root,stateno != 1260) && (root,stateno != 1265)
trigger3 = (root,prevstateno = 1350) && (root,stateno != 1350)
trigger4 = (root,prevstateno = 1470) && (root,stateno != 1470)
trigger5 = (root,prevstateno = 3160) && (root,stateno != 3160)
var(28) = 0

[State VarA, 1]
type = VarAdd
triggerall = var(28) < 2
triggerall = root,movetype != H
triggerall = root,var(28) = 1
trigger1 = (root,prevstateno = [280,285]) && (root,stateno != 280) && (root,stateno != 285)
trigger1 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger1 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger1 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger1 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger1 = (root,prevstateno != 3160) && (root,stateno != 3160)
trigger2 = (root,prevstateno = [238,239]) && (root,stateno != 238) && (root,stateno != 239)
trigger2 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger2 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger2 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger2 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger2 = (root,prevstateno != 3160) && (root,stateno != 3160)
trigger3 = (root,prevstateno = 434) && (root,stateno != 434)
trigger3 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger3 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger3 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger3 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger3 = (root,prevstateno != 3160) && (root,stateno != 3160)
var(28) = 1

;After Burner
[State VarA, 1]
type = VarAdd
triggerall = var(28) < 2
triggerall = root,movetype != H
trigger1 = root,stateno = 1510
trigger1 = root,animelem = 4
var(28) = ifelse(root,var(30) >= 47, 2, 1)

;Overdrive
[State VarA, 1]
type = VarAdd
triggerall = var(28) < 2
trigger1 = root,stateno = [2400,2415]
trigger1 = root,animelem = 5
var(28) = 1
ignorehitpause = 1

[State VarA, 1]
type = VarAdd
triggerall = root,fvar(31) = 0
triggerall = var(28) > 0
triggerall = root,time = 1
triggerall = root,var(28) = -1
trigger1 = root,movetype != H
trigger1 = root,stateno != 238
trigger1 = root,stateno != 239
trigger1 = root,stateno != 250
trigger1 = root,stateno != 260
trigger1 = root,stateno != 434
var(28) = -1

;Heat Up Timer
[State VarS, 1]
type = VarSet
trigger1 = var(28) = 0
trigger2 = root,var(28) = 1
trigger2 = root,movetype != H
trigger2 = (root,prevstateno = [280,285]) && (root,stateno != 280) && (root,stateno != 285)
trigger3 = root,var(28) = 1
trigger3 = root,movetype != H
trigger3 = (root,prevstateno = [238,239]) && (root,stateno != 238) && (root,stateno != 239)
trigger4 = root,var(28) = 1
trigger4 = root,movetype != H
trigger4 = (root,prevstateno = 434) && (root,stateno != 434)
trigger5 = root,stateno = 1510
var(29) = 0

[State VarA, 1]
type = VarAdd
triggerall = root,fvar(31) = 0
trigger1 = stateno != 3100 && stateno != 3110 && stateno != 3120 && stateno != 3130 && stateno != 3140 && stateno != 3150 && stateno != 3160 && stateno != 3170 && stateno != 3180
trigger1 = var(28) > 0
trigger1 = var(29) < 900
var(29) = 1

[State PlayS, 1]
type = null;PlaySnd
triggerall = root,var(28) = 1
triggerall = root,time = 1
trigger1 = (root,prevstateno = [280,285]) && (root,stateno != 280) && (root,stateno != 285)
trigger1 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger1 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger1 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger1 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger1 = (root,prevstateno != 3160) && (root,stateno != 3160)
trigger2 = (root,prevstateno = [238,239]) && (root,stateno != 238) && (root,stateno != 239)
trigger2 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger2 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger2 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger2 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger2 = (root,prevstateno != 3160) && (root,stateno != 3160)
trigger3 = (root,prevstateno = 434) && (root,stateno != 434)
trigger3 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger3 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger3 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger3 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger3 = (root,prevstateno != 3160) && (root,stateno != 3160)
value = 310, 7
volumescale = var(15)

[State Helper, 1]
type = Helper
triggerall = numhelper(7505) = 0
trigger1 = root,time = 1
trigger1 = (root,prevstateno = [280,285]) && (root,stateno != 280) && (root,stateno != 285)
trigger1 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger1 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger1 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger1 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger1 = (root,prevstateno != 3160) && (root,stateno != 3160)
trigger2 = root,time = 1
trigger2 = ((root,prevstateno = [238,239]) && var(2) = 1) && (root,stateno != 238) && (root,stateno != 239)
trigger2 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger2 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger2 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger2 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger2 = (root,prevstateno != 3160) && (root,stateno != 3160)
trigger3 = root,time = 1
trigger3 = (root,prevstateno = 434 && var(2) = 1) && (root,stateno != 434)
trigger3 = (root,prevstateno != [1000,1010]) && (root,stateno != 1000) && (root,stateno != 1010)
trigger3 = (root,prevstateno != [1250,1265]) && (root,stateno != 1260) && (root,stateno != 1265)
trigger3 = (root,prevstateno != 1350) && (root,stateno != 1350)
trigger3 = (root,prevstateno != 1470) && (root,stateno != 1470)
trigger3 = (root,prevstateno != 3160) && (root,stateno != 3160)
trigger4 = root,stateno = 1510
trigger4 = root,animelem = 4
name = "Power_Up"
ID = 7505
stateno = 7505
pos = 0,0;-7,-194
postype = p1
persistent = 1
facing = 1
keyctrl = 0
ownpal = 1
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)

[State VarS, 1];Red Lock Reset
type = VarSet
trigger1 = var(30) = 1
trigger1 = root,stateno != [230,299]
trigger1 = root,stateno != [430,499]
trigger1 = root,stateno != [630,699]
var(30) = 0

[State VarS, 1];Red Lock
type = VarSet
trigger1 = var(30) = 0
trigger1 = numhelper(7502) = 1
trigger1 = helper(7502),var(0) = 1
var(30) = 1

[State VarS, 1];Red Lock Angle
type = VarSet
trigger1 = numhelper(7502) = 1
var(31) = floor(helper(7502),fvar(0))

;-------------------------------------------------------------------------------
;Win Count
[State VarA, 1]
type = ParentVarAdd
trigger1 = root,time = 1
trigger1 = root,win
var(48) = 1
persistent = 0

;-------------------------------------------------------------------------------
;Lose Count
[State VarA, 1]
type = ParentVarAdd
trigger1 = root,time = 1
trigger1 = root,lose
var(49) = 1
persistent = 0

