;---------------------------------------------------------------------------
; Stand get-hit (shaking)
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0
anim = 5000

[State 1, 0]
type = PlaySnd
trigger1 = GetHitVar(Damage) <= 600
trigger1 = Time = 0
trigger1 = random <= 499
value = 5000, Random % 7
[State 1, 0]
type = PlaySnd
trigger1 = GetHitVar(Damage) >= 601
trigger1 = random <= 749
trigger1 = Time = 0
value = 5001, Random % 6

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = A

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 5001 ;Stand get-hit (knocked back)

[State 5000, 7]
type = ChangeState
trigger1 = GetHitVar(yvel) != 0 && HitShakeOver|| GetHitVar(fall) && HitShakeOver
trigger2 = Pos Y != 0 && HitShakeOver
value = 5030

;---------------------------------------------------------------------------
; Crouch get-hit (knocked back)
[Statedef 5011]
type    = C
movetype= H
physics = C
anim = 5020

[State 1, 0]
type = PlaySnd
trigger1 = GetHitVar(Damage) <= 600
trigger1 = Time = 0
trigger1 = random <= 499
value = 5000, Random % 7

[State 1, 0]
type = PlaySnd
trigger1 = GetHitVar(Damage) >= 601
trigger1 = Time = 0
trigger1 = random <= 749
value = 5001, Random % 6

[State 5011, 1]
type = velset
trigger1 = Time = 0
x = gethitvar(xvel)* facing

[state friction cancel] 
type = veladd
trigger1 = !time
x = (vel x / const(movement.crouch.friction)) - vel x
ignorehitpause = 1

[State 5011, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(Slidetime)
x = .6

[State 5011, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 5011, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1
[State 0, NotHitBy]
type = NotHitBy
trigger1 = HitOver
value = ,NT,ST,HT
time = 5
ignorehitpause = 1
[State 5011, 6]
type = ChangeState
trigger1 = HitOver
value = 11
ctrl = 1

;---------------------------------------------------------------------------
; Air get-hit (shaking)
[Statedef 5020]
type    = A
movetype= H
physics = N
velset = 0,0


[State 1, 0]
type = PlaySnd
trigger1 = GetHitVar(Damage) <= 600
trigger1 = Time = 0
trigger1 = random <= 499
value = 5000, Random % 7
[State 1, 0]
type = PlaySnd
trigger1 = GetHitVar(Damage) >= 601
trigger1 = random <= 749
trigger1 = Time = 0
value = 5001, Random % 6
[State 5020, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(airtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5020, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5020, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5020, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5020, 5]
type = ChangeState
triggerall = HitFall || pos y > -10
trigger1 = HitShakeOver
value = 5030

[State 5020, 5]
type = ChangeState
triggerall = !HitFall|| pos y <= -10
trigger1 = HitShakeOver
value = 5025 ;Flip-Out
;---------------------------------------------------------------------------
; Tripped get-hit (shaking)
[Statedef 5070]
type    = A
movetype= H
physics = N
velset = 0,0


[State 400, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 5070,0

[State 5070, 1]
type = ChangeAnim
trigger1 = gethitvar(animtype) != 5
value = 5070
[State 5070, 1]     ;Spinout Anim
type = ChangeAnim
trigger1 = gethitvar(animtype) = 5
value = 5160

[State 5070, 2]
type = SelfState
trigger1 = HitShakeOver
value = 5071
;---------------------------------------------------------------------------
; Air get-hit (fall recovery in air)
[Statedef 5210];Air Tech
type    = A
movetype = I
physics = A
anim = 5210
ctrl = 0
facep2 = 0

[State 0, Random Voice]
type = PlaySnd
trigger1 = Time = 0
value = 5210, Random % 4

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST
time = 1

[State 5210, 1] ;Blink white
type = PalFX
trigger1 = Time
time = 1
add = cond(128 - time*8 >= 0, 128 - time*8, 0),cond(128 - time*8 >= 0, 128 - time*8, 0),cond(128 - time*8 >= 0, 128 - time*8, 0)

[State 5210, 2] ;Turn if not facing opponent
type = Turn
trigger1 = p2dist X < 0 && time

[State 5210, 2] ;Go fwd
type = VelSet
trigger1 = Time = 0
y = -5.5
[State 5210, 2] ;Go fwd
type = VelSet
trigger1 = Time = 0
trigger1 = Command = "holdright"
x = 6*facing
[State 5210, 2] ;Go back
type = VelSet
trigger1 = Time = 0
trigger1 = Command = "holdleft"
x = -6*facing

[State 5210, 5] ;Land on ground
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;Jump land
ctrl = 1

;=============================================================================


;---------------------------------------------------------------------------
; Backroll
[Statedef 5202] ;Ground Tech
type    = S
movetype= I
physics = S
anim = 5125
facep2 = 1


[State 0, Random Voice]
type = PlaySnd
trigger1 = Time = 0
value = 5210, Random % 4

[State 5120, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 5120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 5120, 2]
type = VelSet
trigger1 = Time = 0
x = -15

[State 0, PalFXWiz]
type = PalFX
trigger1 = 1
time = 1
add = 50,50,250
mul = 256,256,256
sinadd = -80,-80,-8,1
invertall = 0
color = 0

[State 5120, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5120, 6] ;Can't be hit right after getting up (short time)
type = NotHitBy
trigger1 = AnimTime = 0
value2 = SCA
time = 3

[State 5120, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

