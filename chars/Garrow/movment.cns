

;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 6061, Effect]
type = Explod
trigger1 = animelemtime(2) >= 0
anim = 8103
scale = 0.60,0.60
postype = p1
facing = 1
pos = -68,0
sprpriority = 3
ownpal = 1
removeongethit = 1
pausemovetime = 99999
supermovetime = 99999
ignorehitpause = 1
persistent = 1
bindtime = 0

[State 100, Build Meter]
type = PowerAdd
trigger1 = command = "holdfwd"
trigger1 = Vel X > 0
value = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 101, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 0,5

[State 100, 4]
type = ChangeState
triggerall = !ailevel
trigger1 = command != "holdfwd"
value = 101

[State 100, 4]
type = ChangeState
triggerall = ailevel && numenemy
trigger1 = p2bodydist x <= 40
value = 101


