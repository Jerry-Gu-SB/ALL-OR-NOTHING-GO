persistent = 0

[State Helper, 1]
type = Helper
triggerall = !ishelper
triggerall = winko
triggerall = numhelper(7650) = 0
triggerall = numenemy
trigger1 = enemynear,gethitvar(chainid) = 3500
name = "Astral_Finish!"
ID = 7650
Stateno = 7650
pos = 0,0
postype = back
keyctrl = 0
ownpal = 1
pausemovetime = 9999999999*99
supermovetime = 9999999999*99
ignorehitpause = 1
persistent = 0

;-------------------------------------------------------------------------------
;Overdrive Variables
[State VarA, 1];Stop Overdrive Countdown from Super Pause.
type = VarAdd
trigger1 = var(10) > 1
var(10) = -1
ignorehitpause = 1

;Stop Overdrive from ticking down
[State VarS, 1]
type = VarSet
trigger1 = fvar(31) > 0
trigger1 = var(10) >= 1
trigger1 = movehit = 1
var(10) = 1+hitpausetime
ignorehitpause = 1

;Stop Overdrive from ticking down
[State VarS, 1]
type = VarSet
trigger1 = fvar(31) > 0
trigger1 = var(10) >= 1
trigger1 = movetype = H
var(10) = 1+gethitvar(hitshaketime)
ignorehitpause = 1

;Overdrive Reset
[State VarS, 1]
type = VarSet
trigger1 = var(10) = 1
trigger1 = fvar(31) <= 0
var(10) = 0
ignorehitpause = 1

;Overdrive Countdown
[State VarA, 1]
type = VarAdd
trigger1 = var(10) = 1
trigger1 = fvar(31) > 0
fvar(31) = -1
ignorehitpause = 1

;Overdrive Reset when below 0
[State VarS, 1]
type = VarSet
trigger1 = fvar(31) < 0
trigger2 = roundstate = 3
trigger3 = var(36) = 1
fvar(31) = 0
ignorehitpause = 1

;Grayscale BG in Overdrive
[State BGPalF, 1]
type = BGPalFX
trigger1 = fvar(31) > 0
color = 0
time = 2
ignorehitpause = 1

;-------------------------------------------------------------------------------
;Astral Finish BG
[State BGPalF, 1]
type = BGPalFX
trigger1 = stateno = [3510,3540]
mul = var(24), var(24), var(24)
time = -1
ignorehitpause = 1

;-------------------------------------------------------------------------------
;Projectile (Proration/Counter Voice/Rapid)
[State VarS, 1];Damage Counter/Proration 1 (1100/1350 Projectile)
type = VarSet
triggerall = fvar(1) = 1
trigger1 = projhit(1101) = 1
trigger1 = numtarget(1101) = 1
trigger2 = projhit(1121) = 1
trigger2 = numtarget(1121) = 1
trigger3 = projhit(1351) = 1
trigger3 = numtarget(1351) = 1
ignorehitpause = 1
persistent = 1
fv = 1
value = .99

;Damage Counter/Proration 2 (1121 Projectile)
[State VarS, 1]
type = VarSet
triggerall = fvar(1) != 1
trigger1 = projhit(1101) = 1
trigger1 = numtarget(1101) = 1
trigger2 = projhit(1121) = 1
trigger2 = numtarget(1121) = 1
ignorehitpause = 1
persistent = 1
fv = 2
value = (.89 ** enemynear, gethitvar(hitcount))

;Damage Counter/Proration 2 (1350 Projectile)
[State VarS, 1]
type = VarSet
triggerall = fvar(1) != 1
trigger1 = projhit(1351) = 1
trigger1 = numtarget(1351) = 1
ignorehitpause = 1
persistent = 1
fv = 2
value = (.40 ** enemynear, gethitvar(hitcount))

;System Voice "Counter"
[State PlayS, 1]
type = PlaySnd
triggerall = fvar(4) = 1
triggerall = !(enemynear,ishelper)
trigger1 = projhit(1101) = 1
trigger1 = numtarget(1101) = 1
trigger2 = projhit(1121) = 1
trigger2 = numtarget(1121) = 1
trigger3 = projhit(1351) = 1
trigger3 = numtarget(1351) = 1
value = 6000, 1
volumescale = helper(9999),var(14)
persistent = 0
ignorehitpause = 1

;-------------------------------------------------------------------------------
;Burst Variables
[State VarS, 1]
type = VarSet
trigger1 = (stateno = [190,194])
trigger1 = roundno = 1
trigger2 = fvar(30) >= 10000
ignorehitpause = 1
fv = 30
value = 10000

[State VarA, 1]
type = VarAdd
trigger1 = roundstate = 2
trigger1 = fvar(30) <= 10000
trigger1 = fvar(31) = 0
trigger1 = life >= const(data.life)/2
ignorehitpause = 1
persistent = 1
fv = 30
value = 0.8

[State VarA, 1]
type = VarAdd
trigger1 = roundstate = 2
trigger1 = fvar(30) <= 10000
trigger1 = fvar(31) = 0
trigger1 = life < const(data.life)/2
trigger1 = life >= const(data.life)/4
ignorehitpause = 1
persistent = 1
fv = 30
value = 2

[State VarA, 1]
type = VarAdd
trigger1 = roundstate = 2
trigger1 = fvar(30) <= 10000
trigger1 = fvar(31) = 0
trigger1 = life < const(data.life)/4
ignorehitpause = 1
persistent = 1
fv = 30
value = 3.2

[State VarA, 1]
type = VarAdd
trigger1 = roundstate = [2,3]
trigger1 = fvar(30) <= 10000
trigger1 = fvar(31) = 0
trigger1 = movetype = H
ignorehitpause = 1
persistent = 0
fv = 30
value = (Gethitvar(damage)*3+100)/100

