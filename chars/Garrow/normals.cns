ground.slidetime = 12
ground.hittime  = 18
ground.velocity = -4.5
guard.hittime = 12
air.velocity = -2.5,-4
air.fall = 1
fall.recovertime = 45
ground.cornerpush.veloff = -5
air.cornerpush.veloff = -5

[State 410, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

