;-------------------------------------------------------------------------------
;Instant Guard
[State VarS, 1];Instant Guard Variable
type = VarSet
triggerall = var(22) = 0
trigger1 = AILevel > 0
trigger1 = (random < AILevel*10) || AILevel > 7 && (random < AILevel*100)
trigger1 = inguarddist
