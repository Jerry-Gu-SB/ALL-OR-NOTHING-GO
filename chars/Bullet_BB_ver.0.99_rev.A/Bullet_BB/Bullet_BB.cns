type = A
movetype = I
anim = 5207
sprpriority = 10
velset = 0,0

[State AssertS, 1]
type = AssertSpecial
trigger1 = time >= 0
flag = noshadow
ignorehitpause = 1

[State Trans, 1]
type = Trans
trigger1 = time <= 6
trans = add

[State Trans, 1]
type = Trans
trigger1 = time > 6
trans = addalpha
alpha = 256 - (time - 6)*25, 256

[State AngleD, 1]
type = AngleDraw
trigger1 = time >= 0
scale = 0.1 + time * 0.17, 0.1 + time * 0.17

[State DestroyS, 1]
type = DestroySelf
trigger1 = animtime = 0
ignorehitpause = 1

