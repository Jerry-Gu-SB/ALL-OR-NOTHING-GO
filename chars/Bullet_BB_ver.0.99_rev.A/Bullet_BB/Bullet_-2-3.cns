[Statedef -2]

;Astral Finish - No lifebar
[State AssertS, 1]
type = AssertSpecial
trigger1 = var(36) = 1
flag = nobardisplay
ignorehitpause = 1

[State ChangeS, 1]
type = ChangeState
triggerall = !alive
triggerall = helper(9999),var(0) = 1
triggerall = anim = 5400
trigger1 = stateno = 5000
trigger2 = stateno = 5010
value = 5400
ctrl = 0

;-------------------------------------------------------------------------------
;Option
[State Helper, 1]
type = Helper
trigger1 = numhelper(9999) = 0
name = "Bullet-Option"
ID = 9999
Stateno = 9999
pos = 0,0
postype = p2
persistent = 0
facing = 1
keyctrl = 0
ownpal = 1
pausemovetime = 9999999999*99
supermovetime = 9999999999*99

