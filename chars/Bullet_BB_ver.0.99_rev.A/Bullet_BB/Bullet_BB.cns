[Data]
life = 1100		;Amount of life to start with
power = 2000		;Amount of maximum power
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 0		;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 111		;Number of points for juggling
sparkno = 6000		;Default hit spark number for HitDefs
guard.sparkno = 40		;Default guard spark number
KO.echo = 0		;1 to enable echo on KO
volumescale = 100		;Volume offset (negative for softer)
IntPersistIndex = 48	;Variables with this index and above will not have their values
FloatPersistIndex = 30 	;reset to 0 between rounds or matches. There are 60 int variables,
  			;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  			;If omitted, then it defaults to 60 and 40 for integer and float
  			;variables repectively, meaning that none are persistent, i.e. all
  			;are reset. If you want your variables to persist between matches,
  			;you need to override state 5900 from common1.cns.

[Size]
xscale = 1		;Horizontal scaling factor.
yscale = 1		;Vertical scaling factor.
ground.back = 54		;Player width (back, ground)
ground.front = 54		;Player width (front, ground)
air.back = 40		;Player width (back, air)
air.front = 40		;Player width (front, air)
height = 200		;Height of player (for opponent to jump over)
attack.dist = 0		;Default attack distance
proj.attack.dist = 0	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = 36, -281		;Approximate position of head
mid.pos = 0, -211		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 5.5		;Walk forward
walk.back = -4.5		;Walk backward
run.fwd  = 15, 0		;Run forward (x, y)
run.back = -15,-10		;Hop backward (x, y)
jump.neu = 0,-29		;Neutral jumping velocity (x, y)
jump.back = -7.8		;Jump back Speed (x, y)
jump.fwd = 7.8		;Jump forward Speed (x, y)
runjump.back = -7.8,-29	;Running jump speeds (opt)
runjump.fwd = 7.8,-29	;.
airjump.neu = 0,-29		;.
airjump.back = -7.8		;Air jump speeds (opt)
airjump.fwd = 7.8		;.
air.gethit.groundrecover = -1,-23    ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = .5,.2     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,-24.5     ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -12       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 12         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -16         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 6        ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 180	;Minimum distance from ground before you can air jump (opt)
yaccel = 1.8		;Vertical acceleration
stand.friction = .88	;Friction coefficient when standing
crouch.friction = .88	;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .2        ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 100          ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -30 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 0   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -4  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = 1.8    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 60      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 80            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = 1.6              ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = -12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .2          ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

[Quotes]
victory0 = "Battle terminated."
victory1 = "You disappoint me."
victory2 = "You never stood a chance."
victory3 = "Give up. That's our difference in skill."
victory4 = "Sorry, but I can't lose."

victory50 = "Hey, does the name \"Kokonoe\" ring a bell for you? If it does, spill everything you've got." ;VS. Ragna
victory51 = "So... you're the \"Hero of Ikaruga.\" Why don't you tell me a little bit about your heroics during the war?" ;VS. Jin
victory52 = "Isn't it hard to move with you skirt fluttering around like that? I hate skirts..." ;VS. Noel
victory53 = "Looks like you might know something about Kokonoe... Would you mind telling me everything you know?" ;VS. Rachel
victory54 = "Hey, where are you putting your paws?! Meat-buns? What are you talking about? Get your hands off of me!" ;VS. Taokaka
victory55 = "Where have I...? Have I seen you before...?" ;VS. Tager
victory56 = "I heard you used to be in Sector Seven. Do you know a doctor named Kokonoe?" ;VS. Litchi
victory57 = "You can't defeat me. Get lost!" ;VS. Arakune
victory58 = "Are you a ninja? Ah, I see... That was very informative. You have my thanks." ;VS. Bang
victory59 = "I can't bear to see children on the battlefield. Go home before this gets out of hand." ;VS. Carl
victory60 = "You're one of the rumored Six Heroes, Hakumen...? Your strength is...impressive." ;VS. Hakumen
victory61 = "Sorry, but I'm busy right now. This battle ends here." ;VS. Nu
victory62 = "I'm not interested in the Library. Go home before you get yourself hurt..." ;VS. Tsubaki
victory63 = "You smell like...the battlefield. You're the cause of all this chaos." ;VS. Hazama
victory64 = "The power of the Azure...I've heard of it, but I never thought it would be this strong. This is indeed dangerous." ;VS. Mu-12
victory65 = "Doesn't it bother you...that people can see...everything?" ;VS. Makoto
victory67 = "I've been on the battlefield my entire life, but this was my first battle against a lycanthrope. It took me a while to adapt..." ;VS. Valkenhayn
victory68 = "A battlefield is no place for a child. Surely you have someone important to you... Go to their side. It will be for the best." ;VS. Platinum
victory69 = "I've heard rumors about you. Colonel Relius Clover of the Librarium... You know something about Kokonoe... And you're gonna tell me what you know." ;VS. Relius
victory70 = "Sealed Armament Izayoi... It's stronger than I thought. But I can't lose. Not now!" ;VS. Izayoi
victory71 = "Looking at your face...reminds me of that song. Argh, get away from me!" ;VS. Amane
victory72 = "Hm? You look a lot like me... C-Could you be... My long-lost twin, separated at birth!?" ;VS. Bullet
victory73 = "Azrael from Sector Seven... You're gonna tell me everything you know about Kokonoe. One way or another..." ;VS. Azrael
victory74 = "You...why are you looking at me? Is something the matter?" ;VS. Kagura
victory75 = "That mission from five years ago! Don't tell me you've forgotten, Kokonoe." ;VS. Kokonoe
victory76 = "The scent of blood... Who the hell are you?" ;VS. Terumi
victory77 = "That thing... Did...did Kokonoe make it...? Ha! of course not. Who am I kidding?" ;VS. Celica
victory78 = "You...you're connected to Kokonoe somehow, I know it! WHERE IS SHE?! Tell me and I'll let you go." ;VS. Lambda-11

victory90 = "You're stronger than you look. I can't let my guard down around you." ;VS. Ares

;-------------------------------------------------------------------------------
;Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State NotHitB, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State VarR, 1]
type = VarRandom
trigger1 = animelem = 1
v = 1
range = 0,1

[State PlayS, 1]
type = PlaySnd
trigger1 = animelem = 1
value = 170, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

;-------------------------------------------------------------------------------
;Draw Game (Time Over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State ChangeS, 1]; If no anim, use go to lose state.
type = ChangeState
trigger1 = time = 0
trigger1 = !selfanimexist(175)
value = 170

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
value = 175

[State NotHitB, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

