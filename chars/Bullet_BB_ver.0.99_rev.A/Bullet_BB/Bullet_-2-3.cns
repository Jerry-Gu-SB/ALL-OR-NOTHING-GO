;Rapid Cancel Reset
[State VarS, 1]
type = VarSet
triggerall = var(30) != 0
trigger1 = ctrl = 1
trigger2 = stateno != [1500,1510]
ignorehitpause = 1
v = 30
value = 0

;Astral Finish - Remove HUD Reset
[State VarS, 1]
type = VarSet
triggerall = numenemy > 0
triggerall = var(36) = 1
;trigger1 = enemynear,authorname != "Ares"
trigger1 = ctrl
ignorehitpause = 1
persistent = 1
v = 36
value = 0

;Astral Finish - Remove HUD
[State VarS, 1]
