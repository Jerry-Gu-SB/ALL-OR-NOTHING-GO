triggerall = vel Y > -1
triggerall = pos Y < 0
triggerall = alive
triggerall = canrecover
trigger1 = !AILevel
trigger1 = ((command = "recovery") && (command != "holdfwd") && (command != "holdback"))
trigger2 = AILevel
trigger2 = random < AILevel*10 || AILevel > 7
