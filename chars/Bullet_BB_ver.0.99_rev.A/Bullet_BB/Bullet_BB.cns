;Win Selection
[Statedef 180]
type = S

;Helper to Center Win Pose
[State Helper, 1]
type = Helper
trigger1 = numexplod(3570) = 0
trigger1 = time = 0
trigger1 = anim != 3550
name = "Win_Helper_Left"
ID = 20188
Stateno = 20188
pos = 0,0
postype = p1
persistent = 0
facing = 1
keyctrl = 0
ownpal = 1

;Helper to Center Win Pose
[State Helper, 1]
type = Helper
trigger1 = numexplod(3570) = 0
trigger1 = time = 0
trigger1 = anim != 3550
name = "Win_Helper_Right"
ID = 20189
Stateno = 20189
pos = 0,0
postype = p1
persistent = 0
facing = 1
keyctrl = 0
ownpal = 1

[State VelM, 1]
type = VelMul
trigger1 = 1
x = 0.88

[State ChangeS, 1];Astral Finsh
type = ChangeState
