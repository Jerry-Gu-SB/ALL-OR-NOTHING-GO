;---------------------------------------------------------------------------
;Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State ChangeS, 1]
type = ChangeState
trigger1 = AILevel
trigger1 = time = 0
value = 21
ctrl = 0

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
;Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1];Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State ChangeS, 1]
type = ChangeState
trigger1 = !alive
value = 5400

;---------------------------------------------------------------------------
;Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
;Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State ChangeS, 1]
type = ChangeState
trigger1 = time = 0
trigger1 = AILevel
value = 21
ctrl = 0

[State 20, 1]
type = VelSet
trigger1 = !AILevel
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = !AILevel
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State PlayS, 1]
type = PlaySnd
trigger1 = anim = 20
trigger1 = animelem = 8
trigger2 = anim = 20
trigger2 = animelem = 11
trigger3 = anim = 21
trigger3 = animelem = 8
trigger4 = anim = 21
trigger4 = animelem = 10
value = 300, 0
volumescale = helper(9999),var(15)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;-------------------------------------------------------------------------------
;Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State ChangeS, 1]
type = ChangeState
trigger1 = AILevel
trigger1 = time = 0
value = 21
ctrl = 0

[State NotHitB, 1]
type = NotHitBy
trigger1 = time && animtime <= 0
value = , AT

[State VarS, 1]
type = VarSet
trigger1 = time >= 0
var(16) = 1
ignorehitpause = 0

[State PlayS, 1]
type = PlaySnd
trigger1 = time = 3
value = 300, 0
volumescale = helper(9999),var(15)

[State 40, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
triggerall = var(3) = 0
trigger1 = prevstateno = 100
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.runjump.fwd.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 4]
type = VelSet
triggerall = var(3) = 0
trigger1 = prevstateno = 101
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.walk.fwd.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 4]
type = VelSet
triggerall = var(3) = 0
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
triggerall = var(3) = 0
trigger1 = animtime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 45, 6]
type = VelSet
triggerall = time = 0
trigger1 = var(3) = 1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, (const(velocity.jump.fwd.x)+4.2), (const(velocity.jump.back.x)-4.2)))
y = -40

[State 45, 6]
type = VelSet
trigger1 = time = 0
trigger1 = var(3) = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = -40

[State AfterI, 1]
type = AfterImage
trigger1 = helper(9999),var(28) = 0
trigger1 = var(3) >= 1
timegap = 1
framegap = 3
length = 15
time = -1
palcontrast = 120,120,120
palmul = 0.75,0.75,0.75
trans = add1

[State Explod, 1]
type = Explod
trigger1 = animtime = 0
anim = 7040
ID = 7040
postype = p1
sprpriority = 0
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = animtime = 0
anim = 7041
ID = 7040
postype = p1
sprpriority = 0
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State Explod, 1]
type = Explod
trigger1 = animtime = 0
anim = 7042
ID = 7040
postype = p1
sprpriority = 0
ownpal = 1
scale = const(size.xscale),const(size.yscale)

[State 40, 6]
type = ChangeState
trigger1 = var(3) = 0
trigger1 = animtime = 0
trigger2 = var(3) >= 1
trigger2 = time = 0
value = 50
ctrl = 1

;-------------------------------------------------------------------------------
;Air Jump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State VarS, 1]
type = VarSet
triggerall = time >= 0
trigger1 = var(4) = 1
trigger2 = prevstateno = 225
trigger3 = prevstateno = 600
trigger4 = prevstateno = 610
trigger5 = prevstateno = 620
var(4) = 2

[State 45, 3]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = !AILevel
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = !AILevel
trigger1 = command = "holdback"
sysvar(1) = -1

[State VarS, 1]
type = VarSet
trigger1 = AILevel
trigger1 = p2movetype = H
sysvar(1) = 1

[State VarS, 1]
type = VarSet
trigger1 = AILevel
trigger1 = random%3 = 0
trigger1 = backedgebodydist > 100
trigger1 = p2movetype != H
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = time = 0
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;-------------------------------------------------------------------------------
;Jump Up
[Statedef 50]
type    = A
physics = A

[State VarS, 1]
type = VarSet
trigger1 = time >= 5
var(16) = 0
ignorehitpause = 0

[State VarS, 1]
type = VarSet
triggerall = var(4) = 0
trigger1 = command != "holdup"
var(4) = 1

[State ChangeS, 1]
type = ChangeState
triggerall = !AILevel
trigger1 = command = "holdup"
trigger1 = var(4) = 1
trigger1 = ctrl = 1
value = 45
ctrl = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 1];Turn
type = ChangeAnim
triggerall = anim != 7
trigger1 = p2dist X < Const720p(-80)
value = 7

[State Turn, 1]
type = Turn
trigger1 = anim = 7 && animelemtime(1) = 0
persistent = 0

[State 50, 1];Change from turning animation
type = ChangeAnim
trigger1 = anim = 7 && animtime = 0
value = ifelse((vel x) = 0, 44, ifelse((vel x) > 0, 45, 46))

[State 50, 2]
type = ChangeAnim
trigger1 = time = 0
value = ifelse((vel x) = 0, 41, ifelse((vel x) > 0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = anim != 7
trigger1 = vel Y > -1
;trigger1 = selfanimexist(anim + 3)
persistent = 0
value = ifelse((vel x) = 0, 44, ifelse((vel x) > 0, 45, 46));anim + 3

[State VarR, 1]
type = VarRandom
trigger1 = time = 0
v = 1
range = 0,1

[State PlayS, 1]
type = PlaySnd
triggerall = time = 0
trigger1 = anim = 41
trigger2 = anim = 42
value = 50, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State PlayS, 1]
type = PlaySnd
triggerall = time = 0
trigger1 = anim = 43
value = 43, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State VarR, 1]
type = VarRandom
trigger1 = anim = 7
trigger1 = animelem = 1
v = 2
range = 0,1

[State PlayS, 1]
type = PlaySnd
triggerall = roundstate = 2
trigger1 = anim = 7
trigger1 = animelem = 1
value = 5, var(2)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

;-------------------------------------------------------------------------------
;Jump Down
[Statedef 51]
type    = A
physics = A
anim = ifelse((vel x) = 0, 44, ifelse((vel x) > 0, 45, 46))

[State StateTypeS, 1]
type = StateTypeSet
trigger1 = (prevstateno = 2210 || prevstateno = 2410)
trigger1 = var(11) != 0
;trigger1 = var(12) != 0
physics = N

[State VarS, 1]
type = VarSet
triggerall = var(4) = 0
trigger1 = command != "holdup"
var(4) = 1

[State ChangeS, 1]
type = ChangeState
triggerall = !AILevel
trigger1 = command = "holdup"
trigger1 = var(4) = 1
trigger1 = var(5) = 0
trigger1 = ctrl = 1
value = 45
ctrl = 1

[State 50, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

[State 50, 1];Turn
type = ChangeAnim
triggerall = prevstateno != 2410
triggerall = anim != 7
trigger1 = time = 0
trigger1 = p2dist X < Const720p(-80)
value = 7

[State Turn, 1]
type = Turn
trigger1 = anim = 7 && animelemtime(1) = 0
persistent = 0

[State 50, 1];Change from turning animation
type = ChangeAnim
triggerall = prevstateno != 1400
triggerall = prevstateno != 1420
triggerall = prevstateno != 1425
triggerall = prevstateno != 2210
triggerall = prevstateno != [2410,2415]
trigger1 = anim = 7 && animtime = 0
value = ifelse((vel x) = 0, 44, ifelse((vel x) > 0, 45, 46))

[State 50, 2]
type = ChangeAnim
triggerall = ((prevstateno = 2210) || (prevstateno = [2410,2415]))
triggerall = var(11) = 0
;triggerall = var(12) = 0
trigger1 = time = 0
value = ifelse((vel x) = 0, 44, ifelse((vel x) > 0, 45, 46))

[State ChangeA, 1]
type = ChangeAnim
triggerall = ((prevstateno = 2210) || (prevstateno = [2410,2415]))
triggerall = var(11) != 0
;triggerall = var(12) != 0
trigger1 = time = 0
value = ifelse((var(11)) = 0, 44, ifelse((var(11)) > 0, 45, 46))

[State ChangeA, 1]
type = ChangeAnim
triggerall = prevstateno = 1400
trigger1 = time = 0
value = 45

[State ChangeA, 1]
type = ChangeAnim
triggerall = ((prevstateno = 1420) || (prevstateno = 1425))
trigger1 = anim = 7 && animtime = 0
trigger2 = anim != 7
trigger2 = time = 0
value = ifelse((vel x) = 0, 44, ifelse((vel x) > 0, 45, 46))
elem = 5

[State ChangeA, 1]
type = ChangeAnim
triggerall = prevstateno = 2510
trigger1 = time = 0
value = 44
elem = 6

[State VelS, 1]
type = VelSet
triggerall = ((prevstateno = 2210) || (prevstateno = [2410,2415]))
triggerall = var(11) != 0
trigger1 = time = 0
x = var(11)

[State VelS, 1]
type = VelSet
triggerall = ((prevstateno = 2210) || (prevstateno = [2410,2415]))
triggerall = var(12) != 0
trigger1 = time = 0
y = var(12)

[State VelA, 1]
type = VelAdd
triggerall = ((prevstateno = 2210) || (prevstateno = [2410,2415]))
triggerall = var(11) != 0
trigger1 = time >= 0
y = const(movement.yaccel)

[State VarR, 1]
type = VarRandom
trigger1 = anim = 7
trigger1 = animelem = 1
v = 2
range = 0,1

[State PlayS, 1]
type = PlaySnd
triggerall = roundstate = 2
trigger1 = anim = 7
trigger1 = animelem = 1
value = 5, var(2)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

[State ChangeS, 1]
type = ChangeState
trigger1 = time >= 0
trigger1 = pos Y > -1
value = 52

