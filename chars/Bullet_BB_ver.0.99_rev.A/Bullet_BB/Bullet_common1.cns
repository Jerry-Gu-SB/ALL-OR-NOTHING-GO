;-------------------------------------------------------------------------------
;Dash (Forward)
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 1]
type = VelSet
trigger1 = time >= 0
x = const(velocity.run.fwd.x) + (time * ifelse(helper(9999),var(28) = 2, 5, ifelse(helper(9999),var(28) = 1, 4, 3)))

[State 100, 1]
type = VelSet
trigger1 = vel X > ifelse(helper(9999),var(28) = 2, 50, ifelse(helper(9999),var(28) = 1, 40, 30))
x = ifelse(helper(9999),var(28) = 2, 50, ifelse(helper(9999),var(28) = 1, 40, 30))

[State 100, 2];Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3];Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn
ignorehitpause = 1

[State PlayS, 1]
type = PlaySnd
trigger1 = time = 0
value = 300, 0
volumescale = helper(9999),var(15)

[State PlayS, 1]
type = PlaySnd
trigger1 = time = 0
value = 300, 1
volumescale = helper(9999),var(15)

[State Explod, 1]
type = Explod
trigger1 = time = 0
anim = 7101
ID = 7101
pos = 4-random%8,1-random%4
postype = p1
