;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

;Astral Ready
[State -2]
type = Helper
trigger1 = power >= 2000
trigger1 = roundstate = 2
trigger1 = p2life <= lifemax*.25
trigger1 = var(21) = 0
triggerall = !numhelper(9877)
triggerall = stateno != [4000,4999]
trigger1 = fvar(35) <= 0
helpertype = normal
ID = 9877
Stateno = 9877
pos = 0,0
PosType = p1
facing = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
ignorehitpause = 1
pausemovetime = 999
supermovetime = 999
persistent = 0

;Not Over Yet
[State -2]
type = Helper
trigger1 = roundstate = 2
trigger1 = alive
Trigger1 = life <= lifemax*.35
trigger1 = !numhelper(9884)
trigger1 = movetype != H
helpertype = normal
ID = 9884
Stateno = 9884
pos = 0,0
PosType = p1
facing = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
ignorehitpause = 1
pausemovetime = 999
supermovetime = 999
persistent = 0

;Negative Penalty Manager
[State -2]
type = Helper
trigger1 = roundstate = 2
trigger1 = alive
trigger1 = !numhelper(9878)
helpertype = normal
ID = 9878
Stateno = 9878
pos = 0,0
PosType = p1
facing = 1
keyctrl = 0
size.xscale = 1
size.yscale = 1
ignorehitpause = 1
pausemovetime = 999
supermovetime = 999
persistent = 0

;Guts
[State -2, Guts]
Type = null;LifeAdd
trigger1 = alive && movetype = H
trigger1 = GetHitVar(damage) > 0 && life > 1
trigger1 = gethitvar(hitcount) < 2
Value = cond(life = GetHitVar(damage),1,floor(GetHitVar(damage)-GetHitVar(damage)*(fvar(20))))
ignorehitpause = 1

[State -2 Guts]
type = DefenceMulSet
trigger1 = numhelper(9884)
trigger1 = movetype = H
value = fvar(20)
ignorehitpause = 1

[State -2, Guts]
type = VarSet
trigger1 = 1
fvar(20) = (0.35*life/lifemax)+0.65;((LifeMax/900.0)-((LifeMax-Life)*0.0005))/(LifeMax/900.0)
ignorehitpause = 1

;Invalid Indicator
[State -2, Invalid Combo]
Type = VarSet
triggerall = !var(52) && numenemy
triggerall = roundstate = 2
trigger1 = enemy,statetype = A && enemy,moveType = H && enemy,alive
trigger1 = enemy,hitfall && enemy,canrecover
trigger1 = (enemy,gethitvar(fall.recovertime)-enemy,gethitvar(hitshaketime)) && enemy,hitover
var(52) = 1
ignorehitpause = 1

[State -2, Invalid Combo]
Type = VarSet
triggerall = var(52)
trigger1 = numenemy
trigger1 = ((enemy,stateno = [5200,5210]) || enemy,movetype != H || enemy,ctrl || enemy,alive = 0)
trigger2 = roundstate >= 3
var(52) = 0
ignoreHitPause = 1

