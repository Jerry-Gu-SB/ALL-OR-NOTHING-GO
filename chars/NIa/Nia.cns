[State -2, Debug]
trigger1=1
type=DisplayToClipboard
ignorehitpause=1
text="Damp=%d Limit=%d juggle=%d hit=%d  Front =%d Back=%d"
params=fvar(10) , fvar(8), var(15) , var(13) , frontedgebodydist , backedgebodydist
ignorehitpause=1

