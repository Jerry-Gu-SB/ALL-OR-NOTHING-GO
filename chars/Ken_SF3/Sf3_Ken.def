[Info]
name = "Street Fighter 3 Ken"        
displayname = "Ken" 
author = "Cloudius"      
pal.defaults = 1, 2, 3, 4, 5, 6 

[Files]
cmd      = KenCMD.cmd   ;Command set
cns      = KenCNS.cns   ;Constants
st       = KenCNS.cns   ;States
stcommon = common1.cns ;Common states
;st1      = Special.cns   ;States
;st2      = SuperArt.cns   ;States
sprite   = KenSFF.sff   ;Sprite
anim     = KenAIR.air   ;Animation
sound    = KenSND.snd   ;Sound
pal1     = Ken.act   ;Palettes (can have up to 12)
pal2     = N3.act	;Thanks to Snake/TTG
pal3     = N2.act	;Thanks to Snake/TTG
pal4     = N1.act	;Thanks to Snake/TTG
pal5     = N4.act	;Thanks to Snake/TTG
pal6     = N5.act	;Thanks to Snake/TTG
pal7     = N6.act	;Thanks to Snake/TTG
pal8     = Alter.act	
pal9     = Blue.act	
pal10    = N6.act
pal11    = N6.act
pal12    = N6.act
