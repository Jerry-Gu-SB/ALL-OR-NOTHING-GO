;Air Dash (Forward)
[Statedef 110]
type = A
physics = N
velset = 0,0
anim = 110
ctrl = 0

[State VarA, 1]
type = VarAdd
trigger1 = time >= 0
trigger1 = var(5) >= 0
var(5) = 1

[State VarS, 1]
type = VarSet
trigger1 = time = 0
var(11) = 0
ignorehitpause = 1

[State VarS, 1]
type = VarSet
trigger1 = time = 0
var(12) = 0
ignorehitpause = 1

[State VelM, 1]
type = VelMul
trigger1 = var(16) = 1
trigger1 = time >= 0
y = 0.90

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = 26

[State VelS, 1]
type = VelAdd
trigger1 = pos Y >= -100
y = -3

[State VelS, 1]
type = VelSet
trigger1 = var(16) = 0
trigger1 = pos Y < -100
trigger2 = var(16) = 1
trigger2 = vel Y > 0
y = 0

[State VarR, 1]
type = VarRandom
trigger1 = time = 0
v = 1
range = 0,1

[State PlayS, 1]
type = PlaySnd
trigger1 = time = 0
value = 110, var(1)+(10*(helper(9999),var(56)))
channel = 1
volumescale = helper(9999),var(14)

