;Distortion Effect (End) Helper
[Statedef 7601]
type = A
physics = N
anim = 9999

[State AssertS, 1]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State AssertS, 1]
type = AssertSpecial
trigger1 = time <= 16
flag = noBG
flag = noFG

[State BGPalF, 1]
type = BGPalFX
trigger1 = time >= 16
mul = (time-15)*23,(time-15)*23,(time-15)*23
time = 1
ignorehitpause = 1

[State RemoveE, 1]
type = RemoveExplod
triggerall = numexplod(7600)
trigger1 = time >= 15
ID = 7600

[State DestroyS, 1]
type = DestroySelf
trigger1 = time >= 26
