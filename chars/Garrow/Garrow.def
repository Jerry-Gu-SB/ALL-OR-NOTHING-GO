; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Garrow"        ;Name of character
displayname = "Garrow" ;Name of character to display
ikemenversion = 0.99           ;Version of M.U.G.E.N character works on (X.XX)
author = "Bentae, spiral"         ;Character author name
pal.defaults = 1,2,3,4,5      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1

; Files for the player
[Files]
cmd     = Garrow.cmd           ;Command set
cns     = Garrow.cns           ;Constants
st      = Garrow.cns  
st1      = normals.cns  
st2      = movment.cns 
st3      = Specials.cns          ;States
stcommon = COMMON.cns      ;Common states (from data/ or motif)
sprite  = Garrow.sff           ;Sprite
anim    = Garrow.air           ;Animation
sound   = Garrow.snd           ;Sound
ai      = Garrow.ai            ;AI hints data (not used)
movelist = movelist.dat     ;Ikemen feature: Movelist


[Palette Keymap]
a = 1


; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
