;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, Build Meter]
type = PowerAdd
trigger1 = command = "holdfwd"
trigger1 = Vel X > 0
value = 1

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 6061, Effect]
type = Explod
trigger1 = animelem = 2
anim = 8101
scale = 0.50,0.50
postype = p1
facing = 1
pos = -3,0
sprpriority = 3
ownpal = 1
removeongethit = 1
pausemovetime = 99999
supermovetime = 99999
ignorehitpause = 1
persistent = 0
bindtime = 0

[State 50, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = 0,2

[State 40, 6] ;Can't be thrown right after getting up
type = NotHitBy
trigger1 = 1
value = , NT,ST,HT
time = 8

[State 40, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 230, 1]
type = PlaySnd
trigger1 = Time = 0
value = 50, 0

[State 50, 1]
type = VelAdd
triggerall = prevstateno = 40
triggerall = anim = 41
trigger1 = Time = [12,26]
trigger1 = Vel X <= 2
trigger1 = command != "holdup" && command != "holddown"
trigger1 = command = "holdfwd"
x = .15

[State 50, 1]
type = VelAdd
triggerall = prevstateno = 40
triggerall = anim = 41
trigger1 = Time = [12,26]
trigger1 = Vel X >= -2
trigger1 = command != "holdup" && command != "holddown"
trigger1 = command = "holdback"
x = -.15

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = null;ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1
[Statedef 90]
type    = A
movetype= I
physics = N
juggle  = 0
velset = 0,0
anim = 41
sprpriority = 2
ctrl = 0

[State 0, VelSet]
type = VelSet
trigger1 = time = 0
y = -6

[State 0, CtrlSet]
type = CtrlSet
trigger1 = time >= 1
value = 1

[State 0, VelSet]
type = VelSet
trigger1 = command = "holdfwd"
trigger2 = ailevel >= 1 && prevstateno = 616
x = 4

[State 0, VelSet]
type = VelSet
trigger1 = command = "holdback" && ailevel = 0
x = -4

[State 0, Explod]
type = Explod
trigger1 = animelem = 1
anim = 7023
ID = 7023
pos = 0,0
postype = P1  ;P2, Front, Back, Left, Right
facing = -1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,.1
random = 0,0
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = .35,.35
sprpriority = 5
ownpal = 1
removeongethit = 1

[State 0, Limiter]
type = Helper
trigger1 = Time = 0
helpertype = normal
name = "Limiter"
ID = 91
stateno = 91
pos = 0,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1


[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 5
value = S5,60
volume = 999
channel = -1
[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 5
value = S5,60
volume = 999
channel = -1

[State 0, CtrlSet]
type = CtrlSet
trigger1 = time >= 1
value = 1

[State 0, VelSet]
type = VelSet
trigger1 = command = "holdfwd"
x = 4

[State 0, VelSet]
type = VelSet
trigger1 = command = "holdback"
x = -4

[State 0, Veladd]
type = Veladd
trigger1 = time > 10
y = .4
x = 0

[State 200, End]
type = ChangeState
triggerall = time > 0
trigger1 = animtime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
facep2 = 1

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 0,0

[State 52, 4]
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
x = 0

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 621, 1]
type = playsnd
trigger1 = !time
trigger2 = animelem = 4
trigger3 = animelem = 8
value = 100,0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = !ailevel
trigger1 = command != "holdfwd"
value = 101

[State 100, 4]
type = ChangeState
triggerall = ailevel && numenemy
trigger1 = p2bodydist x <= 40
value = 101


;---------------------------------------------------------------------------
; Run Stop
[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1
ctrl = 1

[State 100, 1]
type = playsnd
trigger1 = time = 0
value = 101,0

[State 100, 1]
type = VelSet
trigger1 = 1
x = 1

[State 6061, Effect]
type = Explod
trigger1 = time = 0
anim = 6005
scale = .3,.3
postype = p1
facing = -1
pos = 45,0
sprpriority = 3
ownpal = 1
removeongethit = 1
pausemovetime = 99999
supermovetime = 99999
ignorehitpause = 1
persistent = 0
bindtime = 1

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 2]
type = ctrlset
trigger1 = animtime = 0
value = 1

[State 100, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0

;---------------------------------------------------------------------------










[Statedef -2] 


[State -2, Hit Detection]
type=varset
trigger1= movecontact=1 && var(30)<0
var(30)= hitpausetime
ignorehitpause=1

[State -2, Hit Sparks]
type=Helper
triggerAll=MoveContact=1 && var(30)=HitPauseTime
trigger1=MoveHit=1 && NumEnemy
trigger1=var(33)=[8000,8020]
trigger2=MoveGuarded=1 && NumEnemy
trigger2=var(34)=8000 || var(34)=8001
helperType=Normal
stateNo=Ifelse(MoveGuarded, var(34), var(33))
ID=8000
name="Spark"
postype=P1
pos=Ifelse(P2Dist x < 0, 0, Ifelse(P2Dist x < var(35), ceil(P2Dist x), var(35))), var(36)
facing=-1
ownPal=1
size.xscale =1.0
size.yscale =1.0
pauseMoveTime=65535
superMoveTime=65535
ignoreHitPause=1


[State -2, Counter FX]
type=Helper
trigger1= movehit=1 && var(30)=hitpausetime
trigger1= numenemy && var(9) && !numhelper(222) && !numhelper(223) && !numhelper(225)
trigger1= !(hitdefattr=SCA,AT) 
helperType=Normal
stateNo=8290
ID=8290
name="Counter FX"
posType=P1
pos=Ifelse(P2Dist x < 0, 0, Ifelse(P2Dist x < var(35), ceil(P2Dist x), var(35))), var(36)
facing=-1
ownPal=1
size.xscale =1.0
size.yscale =1.0
pauseMoveTime=255
superMoveTime=255
ignoreHitPause=1

[State -2, Counter Flag]
type=VarSet
trigger1=NumEnemy
var(9)=(EnemyNear, MoveType=A)
ignoreHitPause=1

[State -2, Hit Detection]
type=varset
trigger1= 1
var(30)=-1
[State -2, Hit Detection]
type=varrangeset
trigger1= movetype=I 
trigger2= movetype=H
first=5
last=10
value=-1
ignorehitpause=1

[State -2, Assert: UnGuardable]
type=AssertSpecial
trigger1=var(17) > 0
trigger1=var(17) := (var(17) - 1)
flag=UnGuardable
ignoreHitPause=1

[State -2, Hit Count]
type=VarAdd
trigger1=MoveHit=1
trigger1=!(HitDefAttr=SCA, AT)
var(13)=1
[State -2, Hit Count Reset]
type=VarSet
trigger1=NumEnemy && var(13)
trigger1=(EnemyNear, MoveType != H) && (EnemyNear, StateNo != 5300)
var(13)=0
ignoreHitPause=1

[State -2, Juggle Count]
type=varadd
trigger1= movehit=1 
trigger1= !(hitdefattr=SCA,AT)
var(15)=1
[State -2, Juggle Reset Single]
type=varset
triggerall= numenemy=1 && var(15)
trigger1= (enemy,statetype!=A) && ((enemy,stateno!=[5100,5109])||(enemy,statetype!=L)) && (enemy,time>=1)
trigger2= (enemy,movetype!=H) || (enemy,stateno=[120,155]) || (enemy,ctrl)
var(15)=0
ignorehitpause=1
[State -2, Juggle Reset Simul]
type=varset
triggerall= numenemy>=2 && var(15)
trigger1= (enemynear(0),statetype!=A) && (enemynear(0),time>=1)
trigger2= (enemynear(0),movetype!=H) || (enemynear(0),stateno=[120,155]) || (enemynear(0),ctrl)
trigger3= (enemynear(1),statetype!=A) && (enemynear(0),time>=1)
trigger4= (enemynear(1),movetype!=H) || (enemynear(0),stateno=[120,155]) || (enemynear(0),ctrl)
var(15)=0
ignorehitpause=1
[State -2, Free Juggling]
type=varset
trigger1= roundstate!=2
var(15)=0
ignorehitpause=1

[State -2, Juggle Flag]
type=varset
trigger1= numenemy && !var(16)
trigger1= (enemynear,stateno=5040) && !(enemynear,ctrl)
var(16)=1
ignorehitpause=1
[State -2, Juggle Flag Reset Single]
type=varset
triggerall= numenemy=1 && var(16)
trigger1= (enemy,movetype!=H) && (enemy,stateno!=5040)
trigger2= !(enemy,hitshakeover) || (enemy,statetype=L) || (enemy,ctrl)
trigger3= (enemy,movetype!=H) || (enemy,stateno=[120,155]) || (enemy,ctrl)
var(16)=0
ignorehitpause=1
[State -2, Juggle Flag Reset Simul]
type=varset
triggerall= numenemy>=2 && var(16)
trigger1= (enemynear(0),movetype!=H) && (enemynear(0),stateno!=5040)
trigger2= !(enemynear(0),hitshakeover) || (enemynear(0),statetype=L) || (enemynear(0),ctrl)
trigger3= (enemynear(1),movetype!=H) && (enemynear(1),stateno!=5040)
trigger4= !(enemynear(1),hitshakeover) || (enemynear(1),statetype=L) || (enemynear(1),ctrl)
trigger5= (enemynear,movetype!=H) || (enemynear,stateno=[120,155]) || (enemynear,ctrl)
var(16)=0
ignorehitpause=1

[State -2, Downed Limit Single]
type=varadd
triggerall= (numenemy=1||numtarget=1)
trigger1= (enemy, anim=5100)&&(enemy, statetype=L)&&(enemy,time=1)
trigger2= ((enemy, anim=5110)||(enemy, statetype=L))&&(enemy,time=1)
fvar(8)=1
ignorehitpause=1
[State -2, Downed Limit Simul]
type=varadd
triggerall= ((numenemy>=2)||(teammode=simul)||(enemy,teammode=simul)) 
trigger1= (enemynear, anim=5100)&&(enemynear, statetype=L)&&(enemynear,time=1)
fvar(8)=.5
ignorehitpause=1
[State -2, Downed Limit Reset]
type=varset
triggerall= numenemy
trigger1= (enemynear,movetype!=H) && (enemy,ctrl) && (enemy,time>1)
trigger2= moveguarded
fvar(8)=0
ignorehitpause=1

[State -2, Custom Combo End]
type=VarSet
trigger1=var(20) < 0
trigger2=MoveType=H
trigger3=RoundState != 2
trigger4=(StateNo=[3000,4999])
var(20)=0
ignoreHitPause=1
[State -2, Custom Combo Time]
type=VarAdd
trigger1=var(20) > 0
var(20)=-1
ignoreHitPause=1
[State -2, Custom Combo Asserts]
type=AssertSpecial
trigger1=var(20) > 0
flag=NoStandGuard
flag2=NoCrouchGuard
flag3=NoAirGuard
ignoreHitPause=1
[State -2, Custom Combo PalFX]
type=PalFX
trigger1=var(20) > 60
time=2
add=32 + ceil(sin(var(20) / 16.0 * pi) * 32), 32 + ceil(sin(var(20) / 16.0 * pi) * 32), 32 + ceil(sin(var(20) / 16.0 * pi) * 32)
ignoreHitPause=1
[State -2, Custom Combo PalFX]
type=PalFX
trigger1=var(20)=[1,60]
time=2
add=64 + ceil(sin(var(20) / 8.0 * pi) * 64), 64 + ceil(sin(var(20) / 8.0 * pi) * 64), 64 + ceil(sin(var(20) / 8.0 * pi) * 64)
ignoreHitPause=1

[State -2, Throw Protection]
type = NotHitBy
trigger1 = StateNo = 140 && AnimTime = 0
trigger2 = StateNo = 5001 && HitOver
trigger3 = StateNo = 5011 && HitOver
value = , NT,ST,HT
time = 7
ignorehitpause = 1 

;-------------------------------------------------------------------
[State -2, Voice Position]
type=SndPan
trigger1=1
channel=0
pan=0
ignoreHitPause=1
;P2 wall hit---------------------------------------------------------------
[state -2,Bounce SND]
type=playsnd
trigger1=Numenemy && enemy,movetype=H && enemy,stateno=4021 && enemy,time=1
trigger2=P2movetype=H && p2stateno=1127 && enemy,time=1
trigger3=P2movetype=H && p2stateno=4061 && enemy,time=1
persistent=0
ignorehitpause=1
value=669,0
volumescale=100 - (2*time)
channel=22

[State -2,SND]
type=PlaySnd
trigger1=P2movetype=H && p2stateno=4061 && enemy,time=1
trigger2=P2movetype=H && p2stateno=1181 && enemynear,animelemtime(1)=1
trigger3=numtarget(1520) 
trigger3=target,stateno=1046
trigger3=target,time=1
trigger4=numtarget(1602) 
trigger4=target,stateno=1046
trigger4=target,time=1
value =5000,11
channel=6
persistent=0
ignorehitpause=1

[State -2,screen]
type = ScreenBound
triggerall=Numenemy
trigger1 = enemy,stateno=4020 && enemy,movetype=H && (enemy,animelemtime(5)>0||enemy,time>15)
value = p2bodydist x < 30 && BackEdgeDist < 30
[State -2,screen]
type = ChangeState
triggerall = roundstate = 2 && (enemy,stateno=4020)
triggerall = Movetype != H && Stateno != 7827
trigger1 = BackEdgeDist < -10 -const(size.ground.front)-const(size.ground.back)
trigger1 = StateType != A
value = 7827

[State -2, Wall Impact Dust]
type=Helper
triggerall=!numhelper(8111) && numenemy
trigger1=P2movetype=H && p2stateno=1127 && enemy,time=1
trigger2=P2movetype=H && p2stateno=4061 && enemy,time=1
helperType=Normal
stateNo=8111
ID=8111
name="Wall Impact Dust"
posType=P2
facing=-1
pos= floor(-5*const(size.xscale)),ceil(-70*const(size.yscale))
ownPal=1
ignorehitpause=1

[State -2, Ground Impact Dust]
type=Helper
triggerall=!numhelper(8110) && numenemy
trigger1=P2movetype=H && p2stateno=1181 && enemy,time=1
trigger2=P2movetype=H && p2stateno=1391 && enemy,time=1
trigger3=numtarget(1520) 
trigger3=target,stateno=1046
trigger3=target,time=1
trigger4=numtarget(1602) 
trigger4=target,stateno=1046
trigger4=target,time=1
helperType=Normal
stateNo=8110
ID=8110
name="Ground Impact Dust"
posType=P2
facing=-1
pos=0,0
ownPal=1
ignorehitpause=1
;=========================================================================
;Dampener
;=========================================================================
[State -2, Damage based on hits]
type=varadd
triggerall= numenemy && time = 1
trigger1= MoveHit = 1
trigger1=!moveguarded
trigger2=enemynear,movetype=H||enemynear,Statetype=L
fvar(12)=1
ignorehitpause=1
[State -2, Reset var when the opponent recovers]
type=varset
triggerall=numenemy 
trigger1=enemynear,hitover && enemynear,hitshakeover && enemynear,ctrl=1
trigger1=enemynear,movetype!=H || enemynear,Statetype!=L || (enemynear,stateno!=[5000,5120])
trigger2= moveguarded
trigger3=(stateno=[810,860]) && movetype!=H
trigger4=enemynear,stateno=[0,155]
fvar(12)=0
ignorehitpause=1

[State -2, ActionWindow Tick Up]
type         = Mapadd
trigger1     = ctrl && (stateno != 150 || stateno != 152 || stateno != 154)
trigger1    = stateno != [10, 11]
trigger1    = map(ActionWindow) < 30
map         = "ActionWindow"
value         = 1
ignorehitpause     = 1
[State -2, ActionWindow Reset]
type         = MapSet
trigger1    = (stateno = 0 || stateno = [10,11]) && time >= 30
map         = "ActionWindow"
value         = 0
ignorehitpause     = 0

[State -2, ActionWindow ValueFreeze]
type         = MapSet
trigger1     = !ctrl
map         = "AWFreeze"
value         = cond(MAP(actionwindow) = 0, map(ActionWindow),map(ActionWindow)+1)
ignorehitpause     = 1
[State -2, ActionWindow ValueFreeze]
type         = MapSet
trigger1     = stateno = 0 && time >= 30
map         = "AWFreeze"
value         = 0

[State -2, Ctrl Set]
type = VarSet
trigger1 = fvar(12) && ctrl
fvar(11)= 1
ignorehitpause = 1
[State -2, Ctrl Set]
type = VarSet
trigger1 = fvar(12)=0
fvar(11)= 0
ignorehitpause = 1

[state -2, Normal Combo]
type = varset
trigger1 = (stateno=[200,999]) && time=1 && fvar(12) && !var(20) 
fvar(10) = 0.85 * (Ifelse(var(13)<5,1.0,(1.00-(var(13)*.1))))
ignorehitpause = 1

[state -2, Special Combo]
type = varset
trigger1 = (stateno=[1000,2999]) && time=1 && fvar(12) && !var(20) 
fvar(10) = 0.75 * (Ifelse(var(13)<3,1.0,(1.00-(var(13)*.08))))
ignorehitpause = 1

[state -2, Super Combo]
type = varset
trigger1 = (stateno=[3000,4999]) && time=1 && fvar(12) 
fvar(10) = ifelse(var(22), 0.65, ifelse(var(21), 0.9, Ifelse((prevstateno=[200,999]),0.95,1.0)))* (Ifelse(var(13)<38,1.0,(1.00-(var(13)*.07))))
ignorehitpause = 1

[State -2, Dampener - Ctrl Combo]
type=varset
trigger1= fvar(11) && time=1 && fvar(12)>2
fvar(10)= .72 * (10 - ifelse(var(13)>=32, 10, var(13))) / 10.0
ignorehitpause=1

[State -2, Dampener - Custom Combo]
type=varset
trigger1= var(20) && (stateno=[200,999])
fvar(10)= 0.72 * (10 - ifelse(var(13) >= 6, 10, var(13))) / 10.0
ignorehitpause=1
[State -2, Dampener - Custom Combo]
type=varset
trigger1= var(20) && (stateno=[1000,1999]) 
fvar(10)= 0.72 * (10 - ifelse(var(13) >= 3, 10, var(13))) / 10.0
ignorehitpause=1
[State -2, Dampener - Custom Combo Limiter]
type = varset
trigger1 = var(20)
trigger1 = stateno = 220 || stateno = 250 || stateno = 420 || stateno = 440 || stateno = 450
fvar(10) = ifelse(var(13), 0, 0.65) * (10 - ifelse(var(13) >= 3, 10, var(13))) / 10.0

[state -3, Damp Limiter]
type = varset
triggerall = (fvar(10)) < .10
trigger1 = 1
fvar(10) = .10
ignorehitpause = 1

[State -3, Reset var when the opponent recovers]
type=varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
trigger3 = !fvar(12)
trigger4 = !var(13)
fvar(10) = 1

[State -2, Dampener itself]
type=attackmulset
trigger1= 1
value=fvar(10)+0.2*(var(9))
ignorehitpause=1
;----------------------------------------------------------
[State -2, Debug]
trigger1=1
type=DisplayToClipboard
ignorehitpause=1
text="Damp=%d Limit=%d juggle=%d hit=%d  Front =%d Back=%d"
params=fvar(10) , fvar(8), var(15) , var(13) , frontedgebodydist , backedgebodydist
ignorehitpause=1

[Statedef -3]
[State -3, Prevent Crossup]
type = width
trigger1 = movetype != H
edge = 8, 0
ignorehitpause = 1

[State -3, Variable Height]
type = playerpush
triggerall = statetype = A && movetype != H && numenemy = 1
triggerall = p2bodydist x = [ -(enemynear, const(size.ground.back) + enemynear, const(size.ground.front)) , 0]
trigger1 = p2statetype = S
trigger1 = p2dist y >= (enemynear, const(size.height) - 30)
trigger2 = p2statetype = C
trigger2 = p2dist y >= (enemynear, const(size.height) - 56)
trigger3 = p2statetype = L
trigger3 = p2dist y >= 12
value = 0
ignorehitpause = 1