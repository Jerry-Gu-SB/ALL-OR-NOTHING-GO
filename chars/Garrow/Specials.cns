type 				= HitDef
trigger1 				= !movecontact && !movereversed
;===============================
damage 				= 1200,200
pausetime 			= 16,16 + 2 * enemy, movetype = A
getpower 				= 25 
;===============================
attr 				= S,NP
hitflag 				= MAF
guardflag 			= MA
animtype 				= Hard
air.animtype 			= Medium
ground.TYPE 			= Low
air.TYPE 				= High
priority = 1, Hit 
;===============================
sparkno 				= 1
sparkxy 				= -p2dist x * 0.25, -50
hitsound 				= s1,7
guardsound 			= 6,0
;===============================
ground.hittime 		= 20
ground.slidetime		= 8
air.hittime 			= 24
down.hittime 			= 10
ground.velocity 		= -5,-3
air.velocity 			= -5,-3.4
;===============================
guard.ctrltime 		= 16
guard.slidetime		= 10
guard.velocity 		= -9
airguard.velocity 		= -2,-2
;===============================
ground.cornerpush.veloff	= -4
air.cornerpush.veloff 	= -4
down.cornerpush.veloff 	= -8
guard.cornerpush.veloff 	= -8
;===============================
fall 				= 1
;===============================
envshake.time 			= 8
envshake.freq 			= 8
envshake.ampl 			= 1
envshake.phase 		= 0.5


