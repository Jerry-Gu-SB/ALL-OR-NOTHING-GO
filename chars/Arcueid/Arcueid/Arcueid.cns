trigger1 = !matchover
triggerall = var(20) != 1
value = 181

[State 180, 1]
type = ChangeState
trigger1 = matchover
triggerall = var(20) != 1
value = 182

[State 180, 1]
type = ChangeState
trigger1 = var(20) = 1
value = 183

