	cutlow=10
	;;---
	overdrawhigh=5
	overdrawlow=5
	;;---
	tensionhigh=185 ;;t_hi
	tensionlow=25
	startzoom=1
	zoomout=0.85 ;;c_zo
	zoomin=1 ;;c_zi
