[State VarS, 1]
type = VarSet
trigger1 = AILevel >= 1
trigger1 = (stateno = [120,140]) || stateno = 151 || stateno = 153 || stateno = 155
var(22) = 0

[State VarS, 1]
type = VarSet
trigger1 = AILevel <= 0
trigger1 = stateno != [120,159]
trigger1 = var(22)
v = 22
value = 0

;Instant Guard Add Power
[State PowerA, 1]
type = PowerAdd
triggerall = var(22)
triggerall = time = 0
trigger1 = stateno = 150 || stateno = 152 || stateno = 154
trigger1 = time = 0
value = 30

;Instant Guard Color
[State PalF, 1]
